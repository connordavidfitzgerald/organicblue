---
import Layout from "../layouts/Layout.astro";
import { getProducts } from "../lib/products";

const products = await getProducts();

// Hover cycle uses a hand-picked subset of each product's photos rather than
// every image. Numbers are 1-based, matching the photo order in Shopify. The
// first pick doubles as the at-rest cover. Products not listed here fall back
// to cycling through all their images.
const HOVER_PICKS: Record<string, number[]> = {
    "es-rs": [1, 2, 6],
    "es-cap": [1, 2, 4],
    "es-st": [1, 2, 5],
};
---

<Layout title="Organic Blue">
    <!-- Three product columns, aligned with the navbar shop row above the nav.
         Under `md` they stack into one scrolling column of image-over-label
         cards. -->
    <div
        id="shop-stage"
        data-hover-dim
        class="fixed left-0 right-0 top-0 grid grid-cols-3 grid-rows-1 gap-0.5 px-0.5 pt-0.5 text-xs text-black max-md:grid-cols-1 max-md:grid-rows-none max-md:auto-rows-min max-md:overflow-y-auto"
        style="bottom: var(--nav-h, 3.5rem);"
    >
        {
            products.map((p) => {
                // Cycle through the hand-picked photos on hover (falling back to
                // all images), keeping distinct URLs only. Out-of-range picks
                // (e.g. fallback mode with no images) are dropped.
                const picks = HOVER_PICKS[p.slug];
                const selected = picks
                    ? picks.map((n) => p.images[n - 1]).filter(Boolean)
                    : p.images;
                const urls = [...new Set(selected.map((img) => img.url))];
                return (
                    <a
                        href={`/shop/${p.slug}`}
                        data-fade-in
                        data-fade-in-step="0.13"
                        data-fade-in-duration="0.7"
                        data-fade-in-ease="power3.out"
                        class="h-full w-full rounded-xs bg-[#3f3f3f] overflow-hidden flex items-center justify-center max-md:h-auto max-md:flex-col max-md:items-stretch max-md:gap-0.5 max-md:overflow-visible max-md:bg-transparent"
                    >
                        {/* The image gets its own rounded/clipping box so that
                            under `md` — where the anchor stops clipping to make
                            room for the label below — it still reads as a tile. */}
                        <div class="flex h-full w-full items-center justify-center overflow-hidden rounded-xs max-md:h-auto max-md:aspect-[5/6] max-md:bg-[#3f3f3f]">
                            {urls[0] ? (
                                <img
                                    src={urls[0]}
                                    alt={p.images[0]?.alt ?? p.name}
                                    data-hover-gallery={JSON.stringify(urls)}
                                    class="h-full w-full object-cover"
                                />
                            ) : (
                                <span>{p.name}</span>
                            )}
                        </div>
                        {/* Desktop names the products in the navbar's shop row;
                            mobile has no such row, so each card labels itself.
                            Name only — the price belongs on the product page. */}
                        <div class="md:hidden flex items-center w-full h-10 px-2.5 py-[0.8125rem] rounded-xs bg-black text-grey">
                            <span>{p.name}</span>
                        </div>
                    </a>
                );
            })
        }
    </div>
</Layout>

<script>
    import "../scripts/hoverGallery";
    import "../scripts/fadeIn";

    function sizeStage() {
        const nav = document.getElementById("navbar");
        const stage = document.getElementById("shop-stage");
        if (!nav || !stage) return;
        stage.style.setProperty("--nav-h", `${nav.offsetHeight}px`);
    }

    document.addEventListener("astro:page-load", sizeStage);
    window.addEventListener("resize", sizeStage);
</script>
