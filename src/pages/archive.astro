---
import Layout from "../layouts/Layout.astro";
import { getArchiveCollections, urlFor } from "../lib/sanity";

const collections = await getArchiveCollections();
---

<Layout title="Organic Blue">
    <!-- Three collection columns, mirroring the shop index — including the way
         they stack into one scrolling column of image-over-title cards under
         `md`. -->
    <div
        id="archive-stage"
        data-hover-dim
        class="fixed left-0 right-0 top-0 grid grid-cols-3 grid-rows-1 gap-0.5 px-0.5 pt-0.5 text-xs text-black max-md:grid-cols-1 max-md:grid-rows-none max-md:auto-rows-min max-md:overflow-y-auto"
        style="bottom: var(--nav-h, 3.5rem);"
    >
        {
            collections.map((c) => {
                // Cover at rest, then cycle through preview images on hover.
                const sources = [
                    ...(c.coverImage ? [c.coverImage] : []),
                    ...(c.previewImages ?? []),
                ];
                const urls = [
                    ...new Set(
                        sources.map((img) =>
                            urlFor(img)
                                .width(1200)
                                .height(1500)
                                .fit("crop")
                                .auto("format")
                                .url(),
                        ),
                    ),
                ];
                return (
                    <a
                        href={`/archive/${c.slug}`}
                        data-fade-in
                        data-fade-in-step="0.13"
                        data-fade-in-duration="0.7"
                        data-fade-in-ease="power3.out"
                        class="h-full w-full rounded-xs bg-[#3f3f3f] overflow-hidden flex items-center justify-center max-md:h-auto max-md:flex-col max-md:items-stretch max-md:gap-0.5 max-md:overflow-visible max-md:bg-transparent"
                    >
                        {/* The image gets its own rounded/clipping box so that
                            under `md` — where the anchor stops clipping to make
                            room for the title below — it still reads as a tile. */}
                        <div class="flex h-full w-full items-center justify-center overflow-hidden rounded-xs max-md:h-auto max-md:aspect-[5/6] max-md:bg-[#3f3f3f]">
                            {urls[0] ? (
                                <img
                                    src={urls[0]}
                                    alt={c.title}
                                    data-hover-gallery={JSON.stringify(urls)}
                                    class="h-full w-full object-cover"
                                />
                            ) : (
                                <span>{c.title}</span>
                            )}
                        </div>
                        {/* The navbar's archive row is hidden on this page under
                            `md`, so each card carries its own title. */}
                        <div class="md:hidden flex items-center w-full h-10 px-2.5 py-[0.8125rem] rounded-xs bg-black text-grey">
                            <span>{c.title}</span>
                        </div>
                    </a>
                );
            })
        }
    </div>
</Layout>

<script>
    import "../scripts/hoverGallery";
    import "../scripts/fadeIn";

    function sizeStage() {
        const nav = document.getElementById("navbar");
        const stage = document.getElementById("archive-stage");
        if (!nav || !stage) return;
        stage.style.setProperty("--nav-h", `${nav.offsetHeight}px`);
    }

    document.addEventListener("astro:page-load", sizeStage);
    window.addEventListener("resize", sizeStage);
</script>
