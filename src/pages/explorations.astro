---
import Layout from "../layouts/Layout.astro";
import WebScene from "../components/explorations/WebScene.astro";
import InfoOverlay from "../components/explorations/InfoOverlay.astro";
---

<Layout title="Organic Blue">
    <div
        id="exp-stage"
        class="fixed left-0 right-0 top-0 bg-grey"
        style="bottom: var(--nav-h, 5rem);"
    >
        <WebScene />
        {/* "+ Info" toggle + the sheet it opens, both stage-relative so the
           sheet covers the scene and stops at the navbar. */}
        <InfoOverlay />
    </div>
</Layout>

<script>
    function sizeStage() {
        const nav = document.getElementById("navbar");
        const stage = document.getElementById("exp-stage");
        if (!nav || !stage) return;
        stage.style.setProperty("--nav-h", `${nav.offsetHeight}px`);
    }

    // TEMP-PROBE
    if (location.search.includes("probe")) {
        localStorage.setItem(
            "ob-cart",
            JSON.stringify([
                {
                    slug: "es-rs",
                    variantId: "1",
                    name: "ES.RS",
                    priceAmount: 625,
                    priceCurrency: "CAD",
                    image: "",
                    qty: 1,
                },
            ]),
        );
        document.addEventListener("astro:page-load", () => {
            setTimeout(
                () => document.getElementById("info-toggle")?.click(),
                1500,
            );
        });
    }

    document.addEventListener("astro:page-load", sizeStage);
    window.addEventListener("resize", sizeStage);
</script>
