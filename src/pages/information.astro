---
import Layout from "../layouts/Layout.astro";

// About section: the "Index" definitions become accordions under the about text.
const aboutAccordions = [
    {
        term: "Organic",
        body: "The primal layer of human experience: learning through the senses, movement, and direct engagement with the natural world. It reflects our innate connection to ecosystems, the body, and the rhythms of the earth, grounding us in presence, calm, and sustainable ways of living.",
    },
    {
        term: "Blue",
        body: "The modern layer of human experience: learning through technology, built environments, and evolving systems that extend human capability. It represents innovation, networks, and the tools that guide progress toward more connected, sustainable, and human-centered futures.",
    },
    {
        term: "Reconnecting with the Organic",
        body: "The foundation where Organic Blue lives. It is not a return to the past, but a reawakening of the sensory intelligence already within us, awareness of the body, movement, environment, and natural rhythms often muted by modern life. By restoring this connection, technology, design, and innovation can operate with intention, creating a balanced state where contemporary systems and human instinct exist in harmony.",
    },
];

// FAQ section.
const faqIntro =
    "Every Organic Blue piece is made to order, by one set of hands, in our studio in Montréal, Québec. Because each item is crafted individually rather than pulled from existing stock, please allow for production time before your order ships (see Production & Shipping Timelines below).";

const faqAccordions = [
    {
        term: "Returns",
        body: "We do not accept returns or offer refunds, except in cases where an item arrives damaged. If your order arrives damaged, please contact us within 30 days of delivery with:\n\n- Your order number\n- Photos of the damaged item and packaging.\n\nWe will review your claim and arrange a resolution.",
    },
    {
        term: "Repairs",
        body: "We stand behind the quality of our work. If your item requires repair due to a manufacturing fault, we will repair it free of charge.\n\n- Repair cost: Free\n- Shipping cost: Customer is responsible for shipping the item to and from our studio\n\nTo initiate a repair, contact us with your order number and a description (and photos, if possible) of the issue.",
    },
    {
        term: "Exchanges",
        body: "We do not offer exchanges. Please review sizing, colour, and product details carefully before placing your order, as all sales are final.",
    },
    {
        term: "Shipping",
        body: "All orders ship via DHL Standard or DHL Express International, depending on your selected shipping method at checkout.\n\n- All orders ship from Montréal, Québec, Canada\n- Tracking information will be provided once your order ships\n- International customers are responsible for any customs duties, taxes, or import fees applied by their country",
    },
    {
        term: "Production & Shipping Timelines",
        body: "Evening Sun Capsule\n\n- Production period: September 2026\n- Ship date: October 1, 2026\n\nOrders placed for the Evening Sun capsule will be crafted to order throughout September, with all pieces shipping out on October 1, 2026. For questions about your order, repairs, or shipping, please contact us at info@organicblue000.com",
    },
];

// Contact section. Rendered as plain text links on desktop and as tappable rows
// in the mobile stack.
const email = "info@organicblue000.com";
const contactLinks = [
    { label: email, href: `mailto:${email}` },
    { label: "Instagram", href: "#" }, // TODO: real URL
    { label: "Soundcloud", href: "#" }, // TODO: real URL
];

const services = [
    "Research.",
    "Prototyping.",
    "Concepting.",
    "World Building.",
    "Creative Direction.",
    "Small batch production.",
    "Technical Product design.",
];

// Lightweight body formatting so accordion copy can mix paragraphs and bullets:
//   • a blank line starts a new paragraph
//   • a line starting with "- " becomes a bullet
type Block = { type: "p"; text: string } | { type: "ul"; items: string[] };

function parseBody(body: string): Block[] {
    const blocks: Block[] = [];
    let para: string[] = [];
    let list: string[] = [];
    const flushPara = () => {
        if (para.length) blocks.push({ type: "p", text: para.join(" ") });
        para = [];
    };
    const flushList = () => {
        if (list.length) blocks.push({ type: "ul", items: list });
        list = [];
    };
    for (const raw of body.split("\n")) {
        const line = raw.trim();
        if (line === "") {
            flushPara();
            flushList();
        } else if (line.startsWith("- ")) {
            flushPara();
            list.push(line.slice(2).trim());
        } else {
            flushList();
            para.push(line);
        }
    }
    flushPara();
    flushList();
    return blocks;
}
---

<Layout title="Organic Blue">
    <div
        id="info-stage"
        class="fixed left-0 right-0 top-0 grid grid-cols-12 gap-0.5 px-0.5 pt-0.5 text-xs text-grey max-md:hidden"
        style="bottom: var(--nav-h, 3.5rem);"
    >
        <!-- About -->
        <div class="col-span-3 flex flex-col gap-0.5 h-full">
            <div
                class="flex w-full px-1.5 py-1.5 rounded-xs h-8 bg-black"
            >
                About
            </div>
            <div
                class="flex flex-col px-1.5 py-1.5 rounded-xs bg-black"
            >
                Organic Blue is a Montreal-based design studio working across
                technical garments, objects and spatial experiences. Our
                practice is built around a single question: How do the
                environments we move through shape the way we experience
                ourselves?
            </div>
            {
                aboutAccordions.map((item) => (
                    <div class="accordion flex flex-col gap-0.5">
                        <button
                            type="button"
                            class="accordion-header flex items-center justify-between w-full px-1.5 py-1.5 rounded-xs h-8 bg-black text-grey transition-colors hover:bg-grey hover:text-black"
                            aria-expanded="false"
                        >
                            <span>{item.term}</span>
                            <span class="accordion-icon select-none">+</span>
                        </button>
                        <div class="accordion-body hidden space-y-2 px-1.5 py-1.5 rounded-xs bg-grey text-black">
                            {parseBody(item.body).map((block) =>
                                block.type === "ul" ? (
                                    <ul class="list-disc pl-4">
                                        {block.items.map((li) => (
                                            <li>{li}</li>
                                        ))}
                                    </ul>
                                ) : (
                                    <p>{block.text}</p>
                                ),
                            )}
                        </div>
                    </div>
                ))
            }
            <!-- Empty filler soaks up the space down to the navbar; shrinks as
                 accordions open. -->
            <div class="grow min-h-0 rounded-xs bg-grey"></div>
        </div>

        <!-- FAQ -->
        <div class="col-span-3 flex flex-col gap-0.5 h-full">
            <div
                class="flex w-full px-1.5 py-1.5 rounded-xs h-8 bg-black"
            >
                FAQ
            </div>
            <div
                class="flex flex-col px-1.5 py-1.5 rounded-xs bg-black"
            >
                {faqIntro}
            </div>
            {
                faqAccordions.map((item) => (
                    <div class="accordion flex flex-col gap-0.5">
                        <button
                            type="button"
                            class="accordion-header flex items-center justify-between w-full px-1.5 py-1.5 rounded-xs h-8 bg-black text-grey transition-colors hover:bg-grey hover:text-black"
                            aria-expanded="false"
                        >
                            <span>{item.term}</span>
                            <span class="accordion-icon select-none">+</span>
                        </button>
                        <div class="accordion-body hidden space-y-2 px-1.5 py-1.5 rounded-xs bg-grey text-black">
                            {parseBody(item.body).map((block) =>
                                block.type === "ul" ? (
                                    <ul class="list-disc pl-4">
                                        {block.items.map((li) => (
                                            <li>{li}</li>
                                        ))}
                                    </ul>
                                ) : (
                                    <p>{block.text}</p>
                                ),
                            )}
                        </div>
                    </div>
                ))
            }
            <div class="grow min-h-0 rounded-xs bg-grey"></div>
        </div>

        <!-- Contact -->
        <div class="col-span-3 flex flex-col gap-0.5 h-full">
            <div
                class="flex w-full px-1.5 py-1.5 rounded-xs h-8 bg-black"
            >
                Contact
            </div>
            <div
                class="flex flex-col px-1.5 py-1.5 grow rounded-xs bg-black"
            >
                {
                    contactLinks.map((link) => (
                        <a
                            href={link.href}
                            class="w-fit transition-opacity hover:opacity-60"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Services -->
        <div class="col-span-3 flex flex-col gap-0.5 h-full">
            <div
                class="flex w-full px-1.5 py-1.5 rounded-xs h-8 bg-black"
            >
                Services
            </div>
            <ul
                class="flex flex-col px-1.5 py-1.5 grow rounded-xs bg-black"
            >
                {services.map((s) => <li>{s}</li>)}
            </ul>
        </div>
    </div>

    {
        /* Mobile stack. The four desktop columns become one accordion each,
       with About's intro promoted to a permanent hero tile that absorbs the
       slack above them. Its top offset clears the mobile cart toggle, which is
       full width on this page and only present when the cart isn't empty
       (--cart-h is published by the navbar's cart script). */
    }
    <div
        id="info-stage-mobile"
        class="md:hidden fixed left-0 right-0 flex flex-col gap-0.5 px-0.5 overflow-y-auto text-xs text-grey"
        style="top: calc(0.125rem + var(--cart-h, 0px)); bottom: var(--nav-h, 3.5rem);"
    >
        <div
            class="flex flex-col p-2.5 rounded-xs bg-black grow min-h-0 overflow-y-auto text-[1.25rem]"
        >
            Organic Blue is a Montreal-based design studio working across
            technical garments, objects and spatial experiences. Our practice is
            built around a single question: How do the environments we move
            through shape the way we experience ourselves?
        </div>

        {/* About */}
        <div
            class="accordion flex flex-col gap-0.5 shrink-0"
            data-accordion-group="info-mobile"
        >
            <button
                type="button"
                class="accordion-header flex items-center justify-between w-full h-11 px-2.5 py-[0.9375rem] rounded-xs bg-black text-grey"
                aria-expanded="false"
            >
                <span>About</span>
                <span class="accordion-icon select-none">+</span>
            </button>
            <div class="accordion-body hidden space-y-0.5">
                {
                    aboutAccordions.map((item) => (
                        <div
                            class="accordion flex flex-col gap-0.5"
                            data-accordion-group="about-sub"
                        >
                            <button
                                type="button"
                                class="accordion-header flex items-center justify-between w-full h-11 px-2.5 py-[0.9375rem] rounded-xs bg-grey text-black"
                                aria-expanded="false"
                            >
                                <span>{item.term}</span>
                                <span class="accordion-icon select-none">+</span>
                            </button>
                            <div class="accordion-body hidden space-y-2 p-2.5 rounded-xs bg-grey text-black">
                                {parseBody(item.body).map((block) =>
                                    block.type === "ul" ? (
                                        <ul class="list-disc pl-4">
                                            {block.items.map((li) => (
                                                <li>{li}</li>
                                            ))}
                                        </ul>
                                    ) : (
                                        <p>{block.text}</p>
                                    ),
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        {/* FAQ */}
        <div
            class="accordion flex flex-col gap-0.5 shrink-0"
            data-accordion-group="info-mobile"
        >
            <button
                type="button"
                class="accordion-header flex items-center justify-between w-full h-11 px-2.5 py-[0.9375rem] rounded-xs bg-black text-grey"
                aria-expanded="false"
            >
                <span>FAQ</span>
                <span class="accordion-icon select-none">+</span>
            </button>
            <div class="accordion-body hidden space-y-0.5">
                <div class="p-2.5 rounded-xs bg-grey text-black">{faqIntro}</div>
                {
                    faqAccordions.map((item) => (
                        <div
                            class="accordion flex flex-col gap-0.5"
                            data-accordion-group="faq-sub"
                        >
                            <button
                                type="button"
                                class="accordion-header flex items-center justify-between w-full h-11 px-2.5 py-[0.9375rem] rounded-xs bg-grey text-black"
                                aria-expanded="false"
                            >
                                <span>{item.term}</span>
                                <span class="accordion-icon select-none">+</span>
                            </button>
                            <div class="accordion-body hidden space-y-2 p-2.5 rounded-xs bg-grey text-black">
                                {parseBody(item.body).map((block) =>
                                    block.type === "ul" ? (
                                        <ul class="list-disc pl-4">
                                            {block.items.map((li) => (
                                                <li>{li}</li>
                                            ))}
                                        </ul>
                                    ) : (
                                        <p>{block.text}</p>
                                    ),
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        {/* Contact */}
        <div
            class="accordion flex flex-col gap-0.5 shrink-0"
            data-accordion-group="info-mobile"
        >
            <button
                type="button"
                class="accordion-header flex items-center justify-between w-full h-11 px-2.5 py-[0.9375rem] rounded-xs bg-black text-grey"
                aria-expanded="false"
            >
                <span>Contact</span>
                <span class="accordion-icon select-none">+</span>
            </button>
            <div class="accordion-body hidden space-y-0.5">
                {
                    contactLinks.map((link) => (
                        <a
                            href={link.href}
                            class="flex items-center w-full h-11 px-2.5 py-[0.9375rem] rounded-xs bg-grey text-black"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>
        </div>

        {/* Services */}
        <div
            class="accordion flex flex-col gap-0.5 shrink-0"
            data-accordion-group="info-mobile"
        >
            <button
                type="button"
                class="accordion-header flex items-center justify-between w-full h-11 px-2.5 py-[0.9375rem] rounded-xs bg-black text-grey"
                aria-expanded="false"
            >
                <span>Services</span>
                <span class="accordion-icon select-none">+</span>
            </button>
            <div class="accordion-body hidden space-y-0.5">
                <a
                    href={`mailto:${email}`}
                    class="flex items-center w-full h-11 px-2.5 py-[0.9375rem] rounded-xs bg-grey text-black"
                >
                    {email}
                </a>
                <ul class="flex flex-col p-2.5 rounded-xs bg-grey text-black">
                    {services.map((s) => <li>{s}</li>)}
                </ul>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { flicker } from "../scripts/flicker";

    function sizeStage() {
        const nav = document.getElementById("navbar");
        if (!nav) return;
        ["info-stage", "info-stage-mobile"].forEach((id) => {
            document
                .getElementById(id)
                ?.style.setProperty("--nav-h", `${nav.offsetHeight}px`);
        });
    }

    // Collapse an accordion without animating — used when a sibling in the same
    // group takes over. Each accordion's own header/body/icon come first in
    // document order, so a plain querySelector skips any nested ones.
    function closeAccordion(accordion: Element) {
        accordion
            .querySelector<HTMLElement>(".accordion-body")
            ?.classList.add("hidden");
        const icon = accordion.querySelector<HTMLElement>(".accordion-icon");
        if (icon) icon.textContent = "+";
        accordion
            .querySelector<HTMLElement>(".accordion-header")
            ?.setAttribute("aria-expanded", "false");
    }

    function wireAccordions() {
        // Elements are replaced on each navigation, so re-querying here can't
        // stack listeners.
        document
            .querySelectorAll<HTMLButtonElement>(".accordion-header")
            .forEach((btn) => {
                btn.addEventListener("click", () => {
                    const accordion = btn.closest(".accordion");
                    const body =
                        accordion?.querySelector<HTMLElement>(".accordion-body");
                    const icon =
                        btn.querySelector<HTMLElement>(".accordion-icon");
                    if (!accordion || !body || !icon) return;
                    const open = body.classList.toggle("hidden") === false;
                    icon.textContent = open ? "−" : "+";
                    btn.setAttribute("aria-expanded", String(open));

                    // Accordions tagged into a group are mutually exclusive —
                    // the mobile stack uses this so only one section is ever
                    // expanded and the hero tile absorbs the rest. Untagged
                    // accordions (desktop, and the nested ones) toggle freely.
                    const group = accordion.getAttribute(
                        "data-accordion-group",
                    );
                    if (open && group) {
                        document
                            .querySelectorAll(
                                `.accordion[data-accordion-group="${group}"]`,
                            )
                            .forEach((other) => {
                                if (other !== accordion) closeAccordion(other);
                            });
                    }

                    // Blink the revealed copy in with the shared flicker
                    // language, in reading order (no positional re-sort).
                    if (open) {
                        flicker(body.children, { sort: false, step: 0.05 });
                    }
                });
            });
    }

    document.addEventListener("astro:page-load", () => {
        sizeStage();
        wireAccordions();
    });
    window.addEventListener("resize", sizeStage);
</script>
