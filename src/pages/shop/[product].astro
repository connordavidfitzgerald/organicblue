---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import SpecPanel from "../../components/shop/SpecPanel.astro";
import type { Product } from "../../lib/products";

export async function getStaticPaths() {
    // Query lives inside getStaticPaths — Astro hoists this into its own module
    // context, so it can't see module-scope frontmatter imports/consts.
    const { getProducts } = await import("../../lib/products");
    const products = await getProducts();
    return products.map((p) => ({
        params: { product: p.slug },
        props: { product: p },
    }));
}

const { product } = Astro.props as { product: Product };

const cartImage = product.images[0]?.url ?? "";

// One spec layout for every product. The distinguishing specs differ by product
// (ES.RS / ES.ST expose volume + tuned_for; ES.CAP exposes sizing + technical
// features), so column 1 lists all of them — SpecPanel skips any key a product
// doesn't set, so each renders only its own two.
const specColumns = [
    [
        { label: "Volume", key: "volume" },
        { label: "Tuned for", key: "tuned_for" },
        { label: "Sizing", key: "sizing" },
        { label: "Technical Features", key: "technical_features" },
    ],
    [
        { label: "Production", key: "production" },
        { label: "Weight", key: "weight" },
    ],
    [{ label: "Materials", key: "materials" }],
];

// ES.RS ships a local gallery used when Shopify has no images for it; other
// products fall back to a simple placeholder slot.
const esrsModules = import.meta.glob(
    "../../assets/images/esrs_assets/*.{png,jpg,jpeg,webp}",
    { eager: true, import: "default" },
) as Record<string, ImageMetadata>;
const localGallery =
    product.slug === "es-rs"
        ? Object.entries(esrsModules)
              .sort(([a], [b]) => a.localeCompare(b))
              .map(([, img]) => img)
        : [];

// The scroll hint only earns its place when there is a second image to reach.
const galleryLength =
    product.images.length > 0 ? product.images.length : localGallery.length;
const showScrollHint = galleryLength > 1;
---

<Layout title={`${product.name} — Organic Blue`}>
    <div
        id="shop-stage"
        class="fixed left-0 right-0 top-0 flex flex-row gap-0.5 px-0.5 pt-0.5 text-xs text-grey max-md:flex-col"
        style="bottom: var(--nav-h, 3.5rem);"
    >
        <!-- Column 1: product info. Under `md` this stacks below the gallery
             and reorders to description → specs → add-to-cart. -->
        <div class="flex w-full h-full flex-col gap-0.5 max-md:h-auto max-md:shrink-0">
            {/* Row wrapper: a passthrough on desktop (the toggle is hidden, so
                the description fills it), a 9/3 split on mobile. */}
            <div class="flex w-full grow max-md:grid max-md:grid-cols-12 max-md:gap-0.5">
                <div

                    class="flex w-full px-1.5 py-1.5 rounded-xs grow flex-col justify-center items-center bg-black max-md:col-span-9 max-md:p-2.5 max-md:justify-start max-md:items-start max-md:text-left"
                >
                    <div class="text-center max-md:text-left">
                        <p>{product.detailTitle}</p>
                        {
                            product.description && (
                                <div
                                    class="prose-none"
                                    set:html={product.description}
                                />
                            )
                        }
                    </div>
                </div>
                {/* Mobile-only: the spec panel is always visible on desktop, so
                    this toggle only exists under `md`. */}
                <button
                    id="spec-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls="spec-panel"
                    class="md:hidden col-span-3 flex items-start justify-end p-2.5 rounded-xs bg-black text-grey"
                >
                    <span><span id="spec-toggle-sign">+</span> Info</span>
                </button>
            </div>
            {/* Sold out (per Shopify inventory) keeps the row and the price but
                drops the hover swap, and sheds `data-add-to-cart` so Navbar
                never wires a cart click to it. */}
            <button
                type="button"
                disabled={!product.available}
                data-add-to-cart={product.available ? true : undefined}
                data-slug={product.slug}
                data-variant-id={product.variantId}
                data-name={product.name}
                data-price={product.price}
                data-image={cartImage}
                class:list={[
                    "flex w-full items-center px-1.5 py-1.5 rounded-xs h-8 flex-row justify-between bg-black text-grey transition-colors max-md:order-1 max-md:h-10 max-md:px-2.5 max-md:py-[0.8125rem]",
                    product.available
                        ? "hover:bg-grey hover:text-black"
                        : "cursor-default opacity-40",
                ]}
            >
                <span>{product.available ? "Add to cart" : "Sold out"}</span>
                {/* Re-priced per market by src/scripts/currency.ts. */}
                <span data-price-display={product.slug}>{product.price}</span>
            </button>
            <SpecPanel product={product} columns={specColumns} />
        </div>

        {/* Column 2: gallery — Shopify images, else the local set (ES.RS),
            else a placeholder slot. The wrapper carries the column's layout and
            is the positioning context for the paging carets: they have to sit
            against the image's own edges, and the scroller can't host them
            (anything absolute inside it rides away on the first scroll). */}
        <div class="relative h-full w-full max-md:-order-1 max-md:h-auto max-md:grow max-md:min-h-0">
            {
                product.images.length > 0 ? (
                    <div
                        data-fade-in
                        data-fade-in-duration="0.4"
                        data-fade-in-ease="power2.inOut"
                        id="shop-gallery"
                        class="shop-gallery h-full w-full overflow-y-auto snap-y snap-mandatory rounded-xs bg-black max-md:flex max-md:overflow-x-auto max-md:overflow-y-hidden max-md:snap-x"
                    >
                        {product.images.map((img, i) => (
                            <div class="h-full w-full snap-start snap-always max-md:shrink-0">
                                <img
                                    src={img.full}
                                    alt={img.alt}
                                    loading={i === 0 ? "eager" : "lazy"}
                                    decoding="async"
                                    class="w-full h-full object-cover rounded-xs"
                                />
                            </div>
                        ))}
                    </div>
                ) : localGallery.length > 0 ? (
                    <div
                        data-fade-in
                        id="shop-gallery"
                        class="shop-gallery h-full w-full overflow-y-auto snap-y snap-mandatory rounded-xs bg-black max-md:flex max-md:overflow-x-auto max-md:overflow-y-hidden max-md:snap-x"
                    >
                        {localGallery.map((img, i) => (
                            <div class="h-full w-full snap-start snap-always max-md:shrink-0">
                                <Image
                                    src={img}
                                    alt={`${product.name} view ${i + 1}`}
                                    class="w-full h-full object-cover rounded-xs"
                                />
                            </div>
                        ))}
                    </div>
                ) : (
                    <div
                        data-fade-in
                        class="h-full w-full rounded-xs bg-grey flex items-center justify-center text-black"
                    >
                        {product.name} image
                    </div>
                )
            }

            {/* Gallery paging: a pair of carets in the image's bottom-left
                corner, 10px off each edge. Each one steps the scroller by a
                full image and goes transparent once there's nothing left that
                way, so the pair doubles as a position readout. Desktop only —
                under `md` the gallery is a horizontal swipe strip, where the
                gesture is already obvious. The container stays inert to
                pointers so only the carets themselves take clicks away from
                shopZoom's press-to-magnify. */}
            {
                showScrollHint && (
                    <div
                        data-fade-in
                        data-fade-in-duration="0.4"
                        data-fade-in-ease="power2.inOut"
                        class="pointer-events-none absolute bottom-2.5 left-2.5 hidden flex-col items-center gap-2.5 text-black md:flex"
                    >
                        <button
                            id="gallery-prev"
                            type="button"
                            aria-label="Previous image"
                            aria-controls="shop-gallery"
                            class="gallery-step pointer-events-auto cursor-pointer transition-opacity disabled:cursor-default disabled:opacity-30"
                        >
                            <svg
                                viewBox="0 0 8 5"
                                fill="currentColor"
                                aria-hidden="true"
                                class="h-[0.3125rem] w-2"
                            >
                                <path d="M0 5 H8 L4 0 Z" />
                            </svg>
                        </button>
                        <button
                            id="gallery-next"
                            type="button"
                            aria-label="Next image"
                            aria-controls="shop-gallery"
                            class="gallery-step pointer-events-auto cursor-pointer transition-opacity disabled:cursor-default disabled:opacity-30"
                        >
                            <svg
                                viewBox="0 0 8 5"
                                fill="currentColor"
                                aria-hidden="true"
                                class="h-[0.3125rem] w-2"
                            >
                                <path d="M0 0 H8 L4 5 Z" />
                            </svg>
                        </button>
                    </div>
                )
            }
        </div>
</Layout>

<style>
    /* Hide the scrollbar on the gallery column */
    .shop-gallery {
        scrollbar-width: none;
    }
    .shop-gallery::-webkit-scrollbar {
        display: none;
    }
</style>

<script>
    import { flicker } from "../../scripts/flicker";
    import "../../scripts/textReveal";
    import "../../scripts/fadeIn";
    import "../../scripts/shopZoom";

    function sizeStage() {
        const nav = document.getElementById("navbar");
        const stage = document.getElementById("shop-stage");
        if (!nav || !stage) return;
        stage.style.setProperty("--nav-h", `${nav.offsetHeight}px`);
    }

    // Mobile-only: the spec panel is collapsed behind the Info toggle. Above
    // `md` the toggle is hidden and the panel is always shown, so this is inert
    // there. Mirrors the navbar's filters toggle.
    function wireSpecToggle() {
        const toggle = document.getElementById("spec-toggle");
        const panel = document.getElementById("spec-panel");
        const sign = document.getElementById("spec-toggle-sign");
        if (!toggle || !panel) return;

        toggle.addEventListener("click", () => {
            const open = panel.classList.toggle("is-open");
            toggle.setAttribute("aria-expanded", String(open));
            if (sign) sign.textContent = open ? "−" : "+";
            // textReveal.ts already cascaded these rows on page load and left
            // them at full opacity, so re-blink them on each reveal.
            if (open) flicker(panel.querySelectorAll("p, li"), { step: 0.03 });
        });
    }

    // Desktop gallery paging. Each caret steps the snap-scroller by exactly one
    // image (a slide is the scroller's own height), and goes transparent once
    // there's nothing left in that direction — so the pair doubles as a
    // position readout: both solid mid-gallery, one faded at either end.
    //
    // Vertical only, which is all the desktop layout is: under `md` the gallery
    // becomes a horizontal strip and the carets are hidden, leaving the native
    // swipe to it.
    function wireGalleryPaging() {
        const gallery = document.getElementById("shop-gallery");
        const prev = document.getElementById("gallery-prev");
        const next = document.getElementById("gallery-next");
        if (!gallery || !prev || !next) return;

        // A slide is never a whole number of pixels after the layout rounds, so
        // both ends need a pixel of slack to register as reached.
        const EDGE = 1;

        const syncEnds = () => {
            const max = gallery.scrollHeight - gallery.clientHeight;
            (prev as HTMLButtonElement).disabled = gallery.scrollTop <= EDGE;
            (next as HTMLButtonElement).disabled =
                gallery.scrollTop >= max - EDGE;
        };

        const step = (dir: 1 | -1) =>
            gallery.scrollBy({
                top: dir * gallery.clientHeight,
                behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
                    .matches
                    ? "auto"
                    : "smooth",
            });

        prev.addEventListener("click", () => step(-1));
        next.addEventListener("click", () => step(1));
        gallery.addEventListener("scroll", syncEnds, { passive: true });
        // The stage is sized off the navbar, so the scroller's height — and
        // with it which end counts as reached — moves with the viewport.
        window.addEventListener("resize", syncEnds);
        syncEnds();
    }

    // Paging is swipe-only under `md` — the snap-scroller handles it natively.
    // Taps belong to shopZoom's press-to-magnify instead.
    document.addEventListener("astro:page-load", () => {
        sizeStage();
        wireSpecToggle();
        wireGalleryPaging();
    });
    window.addEventListener("resize", sizeStage);
</script>
