                fill="currentColor"></path>
            <path
                d="M81.8387 8.0446H75.1875V0.00390625H75.9847V7.37264H81.8387V8.0446Z"
                fill="currentColor"></path>
            <path
                d="M64.8359 0.00390625H71.1341C71.863 0.00390625 72.4438 0.265855 72.888 0.858087C73.0133 1.02892 73.2639 1.43893 73.2639 2.01977C73.2639 3.10174 72.5691 3.62563 71.863 3.78508C73.0361 3.87619 73.6739 4.8101 73.6739 5.85789C73.6739 6.14262 73.6397 7.04236 72.8652 7.60042C72.33 7.99904 71.7377 8.0446 71.0999 8.0446H64.8359V0.00390625ZM65.6218 0.653084V3.50035H70.5305C71.1227 3.50035 71.7036 3.4548 72.1249 2.95368C72.2502 2.80562 72.4325 2.53228 72.4325 2.06533C72.4325 1.92866 72.4325 1.59838 72.2161 1.26809C71.863 0.69864 71.248 0.653084 70.6444 0.653084H65.6218ZM65.6218 4.1837V7.37264H71.1113C71.7377 7.37264 72.3413 7.24736 72.6716 6.64374C72.8538 6.31346 72.8766 5.99456 72.8766 5.85789C72.8766 5.72123 72.8538 5.24288 72.5691 4.86704C72.0908 4.20648 71.2024 4.1837 70.4621 4.1837H65.6218Z"
                fill="currentColor"></path>
            <path
                d="M115.58 0.00195312V0.0302734L122.75 8.50098H121.977C120.973 5.83683 118.49 3.9474 115.58 3.93555V3.93652C112.659 3.93652 110.163 5.82888 109.156 8.50098H108.383L115.553 0.0302734V0.00195312L115.554 0L115.566 0.0146484L115.579 0L115.58 0.00195312Z"
                fill="currentColor"></path>
        </svg>
    </a>
</nav>

{
    /* White dimming layer shown while the cart is open. Sits above page content
   but below the nav (which is lifted above it), so only cart UI stays crisp.
   Clicking it closes the cart. */
}
<div
    id="cart-overlay"
    class="fixed inset-0 z-40 hidden bg-white/50 backdrop-blur-[4px]"
>
</div>

{
    /* Mobile cart toggle. Under `md` the cart leaves the Shop button and lives
   here instead, parked at the top-left. Closed it matches the Shop button's
   3-column width (measured in JS); open it animates out to full width and the
   panel drops in underneath. Hidden above `md` and while the cart is empty. */
}
<div
    id="cart-mobile"
    data-cart-full={cartFullWidth ? "" : undefined}
    class="md:hidden fixed top-0.5 left-0.5 z-50 hidden text-sm"
>
    <button
        id="cart-mobile-btn"
        type="button"
        aria-label="Toggle cart"
        class="flex items-center justify-between w-full rounded-xs bg-black text-grey h-11 px-2.5 py-[0.9375rem]"
    >
        <span id="cart-mobile-label">Cart</span>
        <span
            id="cart-mobile-num"
            class="flex items-center justify-center rounded-xs bg-grey text-black leading-none"
        >
            0
        </span>
    </button>
</div>

{
    /* Cart panel: item cards + checkout button. On desktop it's fixed and
   positioned by JS above the Shop button, so it floats without pushing any
   navbar rows. Under `md` it's moved inside #cart-mobile and laid out in flow,
   which lines its cards up with the toggle for free. Only shown while open. */
}
<div
    id="cart-panel"
    data-shop-domain={storeDomain}
    class="fixed z-50 hidden flex-col gap-0.5 text-xs text-grey"
>
</div>

<style>
    /* While the cart is open, every non-cart nav element gets a matching
       white/blur veil so only the cart UI reads as active. */
    #navbar.cart-open .cart-dim {
        position: relative;
    }
    #navbar.cart-open .cart-dim::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: rgb(255 255 255 / 0.5);
        backdrop-filter: blur(4px);
        pointer-events: none;
    }

    /* ── Mobile filter panel ──────────────────────────────────────────────
       Under `md` the radio row becomes a panel above the Filters toggle,
       collapsed until the toggle sets `is-open`. It's absolutely positioned
       against the fixed nav rather than sitting in the grid: the nav's own
       background is opaque white, so an in-flow panel would have nothing to
       blur. Parked on the nav's outer top edge, it overlays page content
       instead — and opening it no longer reflows the nav rows. Insets match
       the nav's px-0.5 so it lines up with the buttons below. */
    @media (width < 48rem) {
        #exp-filters {
            display: none;
            position: absolute;
            bottom: 100%;
            left: 0.125rem;
            right: 0.125rem;
            width: auto;
        }
        #exp-filters.is-open {
            display: flex;
        }
        /* Against the light panel the radios invert: a 1px --color-black ring,
           filled solid when selected. */
        #exp-filters input[type="radio"] {
            background: transparent;
            border: 1px solid var(--color-black);
        }
        #exp-filters input[type="radio"]:checked {
            background: var(--color-black);
        }
    }

    /* The mobile cart toggle's width is driven by JS (Shop-button width when
       closed, full width when open) — animate between the two. */
    #cart-mobile {
        transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Under `md` the panel lives inside #cart-mobile, so it drops out of fixed
       positioning and just fills the container — inheriting its left/right
       insets and its animated width. `gap-0.5` between the toggle and the panel
       matches the gap the panel keeps between its own cards. */
    @media (width < 48rem) {
        #cart-panel {
            position: static;
            width: auto;
            margin-top: 0.125rem;
        }
    }

    /* The count square: a 0.875rem text line plus 2.5px top/bottom padding
       (border-box, so that's the height), squared off by the ratio. Sizing it
       explicitly rather than with `aspect-square` — as an auto-width flex item
       the ratio would otherwise resolve off the glyph width, not the height. */
    #cart-mobile-num {
        padding-block: 0.15625rem;
        height: 1.1875rem;
        aspect-ratio: 1;
    }
    @media (prefers-reduced-motion: reduce) {
        #cart-mobile {
            transition: none;
        }
    }
</style>

<script>
    import { gsap } from "gsap";

    // Broadcast filter changes so the explorations WebScene can react.
    document.addEventListener("astro:page-load", () => {
        const fieldset = document.getElementById("exp-filters");
        if (!fieldset) return;

        // Mobile: the "Filters" row toggles the panel open/closed, and its
        // trailing sign tracks that state. Above `md` the panel is always shown
        // and the sign is hidden, so the toggle is inert there.
        const toggle = document.getElementById("filters-toggle");
        const sign = document.getElementById("filters-toggle-sign");

        // Rows cascade in with the same language as the product spec panel
        // (textReveal.ts): a short fade per row, staggered top-to-bottom.
        const REVEAL_DUR = 0.3;
        const REVEAL_STEP = 0.04;
        const REVEAL_DELAY = 0.1;

        const rows = () =>
            Array.from(fieldset.querySelectorAll<HTMLElement>("label"));
        const reducedMotion = () =>
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const setOpen = (open: boolean) => {
            toggle?.setAttribute("aria-expanded", String(open));
            if (sign) sign.textContent = open ? "−" : "+";

            const labels = rows();
            gsap.killTweensOf(labels);

            if (reducedMotion()) {
                labels.forEach((row) => (row.style.opacity = ""));
                fieldset.classList.toggle("is-open", open);
                return;
            }

            if (open) {
                fieldset.classList.add("is-open");
                gsap.fromTo(
                    labels,
                    { opacity: 0 },
                    {
                        opacity: 1,
                        duration: REVEAL_DUR,
                        delay: REVEAL_DELAY,
                        stagger: REVEAL_STEP,
                        onComplete: () =>
                            labels.forEach((row) => (row.style.opacity = "")),
                    },
                );
                return;
            }

            // Closing runs the cascade backwards, then collapses the panel.
            gsap.to(labels, {
                opacity: 0,
                duration: 0.2,
                stagger: { each: REVEAL_STEP, from: "end" },
                onComplete: () => {
                    fieldset.classList.remove("is-open");
                    labels.forEach((row) => (row.style.opacity = ""));
                },
            });
        };

        toggle?.addEventListener("click", () =>
            setOpen(!fieldset.classList.contains("is-open")),
        );

        fieldset.addEventListener("change", (e) => {
            const target = e.target as HTMLInputElement;
            if (target.name !== "exp-filter") return;
            window.dispatchEvent(
                new CustomEvent("filter:change", {
                    detail: { category: target.value },
                }),
            );
        });

        // Reset: restore the "All" filter (only re-applying it if it changed, to
        // avoid a redundant relayout flash) and fly the sphere back to its
        // initial overview.
        const reset = document.getElementById("exp-reset");
        reset?.addEventListener("click", () => {
            const all = fieldset.querySelector<HTMLInputElement>(
                'input[value="all"]',
            );
            if (all && !all.checked) {
                all.checked = true;
                window.dispatchEvent(
                    new CustomEvent("filter:change", {
                        detail: { category: "all" },
                    }),
                );
            }
            window.dispatchEvent(new CustomEvent("scene:reset"));
        });
    });
</script>

<script>
    import { flicker, flickerOut } from "../scripts/flicker";

    // ---- Cart ---------------------------------------------------------------
    // Client-side cart persisted in localStorage. The navbar is re-rendered per
    // page (Astro), so on every page load we rebuild the cart UI from storage
    // and re-wire the add-to-cart buttons that live on product pages.

    type CartItem = {
        slug: string;
        variantId: string; // numeric Shopify variant id, for the checkout link
        name: string;
        priceAmount: number;
        priceCurrency: string;
        image: string;
        qty: number;
    };

    const STORAGE_KEY = "ob-cart";
    const GAP = 2; // px, matches the nav's gap-0.5
    const MOBILE_INSET = 2; // px, matches #cart-mobile's top-0.5/left-0.5
    const EXPAND_MS = 0; // matches #cart-mobile's width transition
    let cartOpen = false;
    let expandTimer: number | null = null;

    const prefersReducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const readCart = (): CartItem[] => {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw ? (JSON.parse(raw) as CartItem[]) : [];
        } catch {
            return [];
        }
    };

    const writeCart = (items: CartItem[]) => {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    };

    // "590 CAD" -> { amount: 590, currency: "CAD" }
    const parsePrice = (display: string) => {
        const match = display.trim().match(/([\d.,]+)\s*(\S+)?/);
        const amount = match ? Number(match[1].replace(/,/g, "")) : 0;
        const currency = match && match[2] ? match[2] : "";
        return { amount: isNaN(amount) ? 0 : amount, currency };
    };

    const formatMoney = (amount: number, currency: string) =>
        `${Math.round(amount)}${currency ? " " + currency : ""}`;

    const addToCart = (data: {
        slug: string;
        variantId: string;
        name: string;
        price: string;
        image: string;
    }) => {
        const items = readCart();
        const existing = items.find((i) => i.slug === data.slug);
        if (existing) {
            existing.qty += 1;
        } else {
            const { amount, currency } = parsePrice(data.price);
            items.push({
                slug: data.slug,
                variantId: data.variantId,
                name: data.name,
                priceAmount: amount,
                priceCurrency: currency,
                image: data.image,
                qty: 1,
            });
        }
        writeCart(items);
        // Adding an item pops the cart open (and flickers it in via setOpen).
        setOpen(true);
    };

    const removeFromCart = (slug: string) => {
        writeCart(readCart().filter((i) => i.slug !== slug));
        render();
    };

    // Reveal the panel and blink its cards/checkout in with the shared flicker
    // language. render() rebuilds them each time, so this catches whatever is
    // currently shown.
    const revealPanel = (panel: HTMLElement) => {
        panel.classList.remove("hidden");
        panel.classList.add("flex");
        flicker(panel.children, { step: 0.07 });
    };

    const setOpen = (open: boolean) => {
        const panel = document.getElementById("cart-panel");

        // A pending mobile reveal is stale the moment the state changes again.
        if (expandTimer !== null) {
            clearTimeout(expandTimer);
            expandTimer = null;
        }

        // Closing: blink the cards/checkout out first, then tear the panel down.
        // The toggle's shrink runs off render(), so the items clear before the
        // button collapses — the open sequence in reverse.
        if (!open && panel && panel.children.length > 0) {
            flickerOut(Array.from(panel.children), () => {
                cartOpen = false;
                render();
            });
            return;
        }

        const wasOpen = cartOpen;
        cartOpen = open;
        render();
        if (!open || !panel) return;

        // Under `md`, opening from closed widens the toggle first — hold the
        // panel back until that lands so the two read as one sequence rather
        // than the cards stretching along with the button. Adding to an already
        // open cart isn't animating any width, so it reveals immediately.
        if (wasOpen || !isMobile() || prefersReducedMotion()) {
            revealPanel(panel);
            return;
        }

        panel.classList.add("hidden");
        panel.classList.remove("flex");
        expandTimer = window.setTimeout(() => {
            expandTimer = null;
            revealPanel(panel);
        }, EXPAND_MS);
    };

    // Build one cart item card matching the spec: 3-col grid, image / title +
    // quantity / price + remove, everything top-aligned.
    const buildCard = (item: CartItem) => {
        const card = document.createElement("div");
        card.className =
            "cart-item w-full grid grid-cols-3 gap-1.5 max-md:gap-2.5 items-start p-1.5 max-md:p-2.5 rounded-xs bg-black text-grey";

        const imgCol = document.createElement("div");
        if (item.image) {
            const img = document.createElement("img");
            img.src = item.image;
            img.alt = item.name;
            img.className = "w-full h-full object-cover rounded-xs";
            imgCol.appendChild(img);
        }

        const infoCol = document.createElement("div");
        infoCol.className = "flex flex-col";
        const nameEl = document.createElement("p");
        nameEl.textContent = item.name;
        const qtyEl = document.createElement("p");
        qtyEl.textContent = `Quantity: ${item.qty}`;
        infoCol.append(nameEl, qtyEl);

        const priceCol = document.createElement("div");
        priceCol.className = "flex flex-col items-end text-right";
        const priceEl = document.createElement("p");
        priceEl.textContent = formatMoney(
            item.priceAmount * item.qty,
            item.priceCurrency,
        );
        const removeEl = document.createElement("button");
        removeEl.type = "button";
        removeEl.className =
            "opacity-50 transition-opacity hover:opacity-100 cursor-pointer";
        removeEl.textContent = "Remove";
        removeEl.addEventListener("click", () => removeFromCart(item.slug));
        priceCol.append(priceEl, removeEl);

        card.append(imgCol, infoCol, priceCol);
        return card;
    };

    const buildCheckout = (items: CartItem[]) => {
        const currency = items[0]?.priceCurrency ?? "";
        const total = items.reduce((sum, i) => sum + i.priceAmount * i.qty, 0);
        const btn = document.createElement("button");
        btn.id = "cart-checkout";
        btn.type = "button";
        btn.className =
            "flex items-center justify-between w-full px-1.5 py-1.5 rounded-xs h-8 max-md:h-11 max-md:px-2.5 max-md:py-[0.9375rem] bg-black text-grey transition-colors hover:bg-grey hover:text-black";
        const label = document.createElement("span");
        label.textContent = "Checkout";
        const totalEl = document.createElement("span");
        totalEl.textContent = formatMoney(total, currency);
        btn.append(label, totalEl);

        // Hand off to Shopify's hosted checkout via a cart permalink:
        //   https://{store}/cart/{variantId}:{qty},{variantId}:{qty}
        // which loads a fresh cart with these lines and lands on checkout.
        btn.addEventListener("click", () => {
            const domain =
                document.getElementById("cart-panel")?.dataset.shopDomain;
            const lines = items
                .filter((i) => i.variantId)
                .map((i) => `${i.variantId}:${i.qty}`)
                .join(",");
            if (!domain || !lines) return;
            window.location.href = `https://${domain}/cart/${lines}`;
        });
        return btn;
    };

    // Under `md` the cart is the fixed toggle at the top-left, not the badge in
    // the Shop button.
    const isMobile = () => window.matchMedia("(width < 48rem)").matches;

    // Size + label the mobile toggle. Closed it matches the Shop button so it
    // reads as the same 3-column tile; open it stretches to the full width its
    // top-0.5/left-0.5 inset allows, and the CSS width transition animates it.
    const syncMobileCart = (totalQty: number) => {
        const cartMobile = document.getElementById("cart-mobile");
        const shopNav = document.getElementById("shop-nav");
        if (!cartMobile || !shopNav) return;

        const openWidth = `${document.documentElement.clientWidth - MOBILE_INSET * 2}px`;
        // On /information the toggle is full width in both states.
        const closedWidth =
            cartMobile.dataset.cartFull !== undefined
                ? openWidth
                : `${shopNav.getBoundingClientRect().width}px`;

        // Adding to an empty cart un-hides the toggle and opens it in the same
        // pass. A width set on an element that wasn't rendered a moment ago has
        // nothing to transition from, so paint it closed and flush layout first
        // — otherwise it would snap straight to full width.
        const wasHidden = cartMobile.classList.contains("hidden");
        cartMobile.classList.toggle("hidden", totalQty === 0);
        if (wasHidden && totalQty > 0 && cartOpen) {
            cartMobile.style.width = closedWidth;
            void cartMobile.offsetWidth;
        }

        cartMobile.style.width = cartOpen ? openWidth : closedWidth;

        // The panel rides inside the toggle's container under `md` (in flow,
        // so it picks up the insets and animated width) and floats free of it
        // on desktop.
        const panel = document.getElementById("cart-panel");
        const host = isMobile() ? cartMobile : document.body;
        if (panel && panel.parentElement !== host) host.appendChild(panel);

        const label = document.getElementById("cart-mobile-label");
        const num = document.getElementById("cart-mobile-num");
        if (label) label.textContent = cartOpen ? "Close" : "Cart";
        if (num) num.textContent = cartOpen ? "✕" : String(totalQty);

        // Most pages let the toggle float over their content, but the
        // information page stacks beneath it. Publish the space it occupies
        // (its height plus one gap, or zero while empty) for those layouts.
        document.documentElement.style.setProperty(
            "--cart-h",
            totalQty === 0 ? "0px" : `${cartMobile.offsetHeight + MOBILE_INSET}px`,
        );
    };

    // Float the panel directly above the Shop button: same left/width, its
    // bottom edge one gap above the button's top. Fixed positioning means it
    // never pushes the navbar rows around.
    //
    // Under `md` none of this applies — the panel is reparented into
    // #cart-mobile and laid out in flow — so the inline offsets are cleared
    // instead, letting the stylesheet take over. Unlike the desktop path this
    // has to run even while closed, so a stale offset can't survive a resize
    // across the breakpoint.
    const positionPanel = () => {
        const panel = document.getElementById("cart-panel");
        if (!panel) return;

        if (isMobile()) {
            panel.style.left = "";
            panel.style.width = "";
            panel.style.top = "";
            panel.style.bottom = "";
            return;
        }

        const shopNav = document.getElementById("shop-nav");
        if (!shopNav || !cartOpen) return;
        const rect = shopNav.getBoundingClientRect();
        panel.style.left = `${rect.left}px`;
        panel.style.width = `${rect.width}px`;
        panel.style.top = "";
        panel.style.bottom = `${window.innerHeight - rect.top + GAP}px`;
    };

    const render = () => {
        const nav = document.getElementById("navbar");
        const panel = document.getElementById("cart-panel");
        const count = document.getElementById("cart-count");
        const shopNav = document.getElementById("shop-nav");
        const label = document.getElementById("shop-nav-label");
        const overlay = document.getElementById("cart-overlay");
        if (!nav || !panel || !count || !shopNav || !label || !overlay) return;

        const items = readCart();
        const totalQty = items.reduce((sum, i) => sum + i.qty, 0);

        // Empty cart resets everything back to a plain Shop button.
        if (totalQty === 0) cartOpen = false;

        // Count badge on the Shop button. Closed: "Cart" + the item count in its
        // own box. Open: the boxed number is dropped and the label becomes a
        // plain ✕ (close affordance) — no box around it.
        const countNum = document.getElementById("cart-count-num");
        const countLabel = document.getElementById("cart-count-label");
        if (countLabel) countLabel.textContent = cartOpen ? "✕" : "Cart";
        if (countNum) {
            countNum.textContent = String(totalQty);
            countNum.classList.toggle("hidden", cartOpen);
            countNum.classList.toggle("flex", !cartOpen);
        }
        // As a lone ✕ the badge should be a square; with "Cart" + the count box
        // it needs horizontal padding instead.
        count.classList.toggle("aspect-square", cartOpen);
        count.classList.toggle("px-1", !cartOpen);

        // Under `md` the Shop button is only ever a link to /shop — the cart
        // toggle lives in #cart-mobile — so none of the swaps below apply, and
        // it joins the rest of the nav under the dimming veil instead.
        const mobile = isMobile();
        shopNav.classList.toggle("cart-dim", mobile);

        // While open the Shop button acts as a cart toggle, not a link — drop its
        // href so the browser doesn't show a /shop hover preview over the button.
        if (cartOpen && !mobile) shopNav.removeAttribute("href");
        else shopNav.setAttribute("href", "/shop");
        count.classList.toggle("hidden", totalQty === 0);
        count.classList.toggle("inline-flex", totalQty > 0);
        shopNav.classList.toggle("justify-between", totalQty > 0 && !mobile);

        syncMobileCart(totalQty);

        // Panel contents (item cards + checkout), only built while open.
        panel.replaceChildren();
        if (cartOpen && totalQty > 0) {
            items.forEach((item) => panel.appendChild(buildCard(item)));
            panel.appendChild(buildCheckout(items));
        }

        // Open state: reveal panel + overlay, dim the rest, swap label to "Cart".
        label.textContent = cartOpen && !mobile ? "Cart" : "Shop";
        nav.classList.toggle("cart-open", cartOpen);
        overlay.classList.toggle("hidden", !cartOpen);
        panel.classList.toggle("hidden", !cartOpen);
        panel.classList.toggle("flex", cartOpen);
        nav.style.zIndex = cartOpen ? "50" : "";
        positionPanel();
    };

    const wire = () => {
        // Fresh page — start with the cart closed.
        cartOpen = false;

        // Add-to-cart buttons live on product pages.
        document
            .querySelectorAll<HTMLElement>("[data-add-to-cart]")
            .forEach((el) => {
                if (el.dataset.cartWired) return;
                el.dataset.cartWired = "1";
                el.addEventListener("click", () =>
                    addToCart({
                        slug: el.dataset.slug ?? "",
                        variantId: el.dataset.variantId ?? "",
                        name: el.dataset.name ?? "",
                        price: el.dataset.price ?? "",
                        image: el.dataset.image ?? "",
                    }),
                );
            });

        // The count badge toggles the cart open/closed.
        const count = document.getElementById("cart-count");
        count?.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            setOpen(!cartOpen);
        });

        // The mobile toggle at the top-left does the same job under `md`.
        document
            .getElementById("cart-mobile-btn")
            ?.addEventListener("click", () => setOpen(!cartOpen));

        // While the cart is open the Shop button reads "Cart", so it shouldn't
        // navigate to /shop — clicking it (anywhere but the ✕, which handles its
        // own click above) just closes the cart. Under `md` it stays a plain
        // link, since the cart isn't in it.
        document.getElementById("shop-nav")?.addEventListener("click", (e) => {
            if (!cartOpen || isMobile()) return;
            e.preventDefault();
            setOpen(false);
        });

        // Clicking the dimming overlay closes the cart.
        document
            .getElementById("cart-overlay")
            ?.addEventListener("click", () => setOpen(false));

        render();
    };

    // Keep the floating panel — and the mobile toggle, whose closed width is
    // measured off the Shop button — aligned as the viewport shifts.
    window.addEventListener("resize", () => {
        const totalQty = readCart().reduce((sum, i) => sum + i.qty, 0);
        syncMobileCart(totalQty);
        positionPanel();
    });
    document.addEventListener("astro:page-load", wire);
</script>
