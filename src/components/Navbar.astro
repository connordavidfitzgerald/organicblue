---
import { getProducts } from "../lib/products";
import { getArchiveCollections } from "../lib/sanity";
import { storeDomain } from "../lib/shopify";

const products = await getProducts();
const collections = await getArchiveCollections();

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
    { label: "Shop", href: "/shop" },
    { label: "Explorations", href: "/explorations" },
    { label: "Information", href: "/information" },
    { label: "Archive", href: "/archive" },
];

// A nav item is active on its own route and any nested route (e.g. /shop/es-rs).
const isActive = (href: string) =>
    href === "/"
        ? pathname === "/"
        : pathname === href || pathname.startsWith(href + "/");
const isHome = pathname === "/";

// Modular filter row — only rendered on the explorations page.
const showFilters = pathname === "/explorations";
const filters = ["All", "Environment", "Product", "Prototype", "Research"];

// Modular shop row — shown on the shop index and every product detail page.
const showShop = pathname === "/shop" || pathname.startsWith("/shop/");
const currentSlug = pathname.startsWith("/shop/")
    ? pathname.slice("/shop/".length)
    : null;

// Modular archive row — shown on the archive index and every collection page.
// Mirrors the shop row: on the index all labels read as active; on a collection
// page only the current one does.
const showArchive =
    pathname === "/archive" || pathname.startsWith("/archive/");
const currentArchiveSlug = pathname.startsWith("/archive/")
    ? pathname.slice("/archive/".length)
    : null;

// The Shop nav button doubles as the cart toggle. Its count badge is the
// inverse of the button's own colours (button black -> badge grey, and vice
// versa), so we key both off the same active check.
const shopActive = isActive("/shop");

// The mobile cart normally matches the Shop button's 3-column width, but the
// information page's stacked layout reads better with it spanning the full
// width even while closed.
const cartFullWidth = pathname === "/information";
---

<nav
    id="navbar"
    class="grid grid-cols-12 gap-0.5 px-0.5 fixed bottom-0 w-full text-sm text-black z-10 bg-white py-0.5"
>
    {
        showFilters && (
            <>
                {/* DISABLED navbar variant of the featured-product bar. Kept
                    behind `false` so it's easy to restore. The active variant now
                    lives in WebScene, tracking under the framed image. When
                    re-enabling, also restore the `feature:change` dispatch in
                    WebScene (syncFeature) and the listener in the script below. */}
                {false && (
                    <div
                        id="feature-bar"
                        data-nav-key="feature"
                        data-nav-state="static"
                        class="cart-dim col-span-12 hidden bg-black text-grey text-base items-center justify-between w-full px-1.5 py-1.5 rounded-xs h-10"
                    >
                        <span id="feature-name" class="truncate" />
                        <a
                            id="feature-shop"
                            href="#"
                            class="flex h-full shrink-0 items-center gap-0.5 rounded-xs bg-grey px-5 text-xs leading-none text-black transition-colors hover:bg-black hover:text-grey"
                        >
                            <span>Shop</span>
                            <svg
                                viewBox="0 0 10 10"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                                class="h-2.5 w-2.5"
                            >
                                <path d="M3 7 L7 3 M4.5 3 H7 V5.5" />
                            </svg>
                        </a>
                    </div>
                )}
                {/* Desktop: a static "Filters" label sitting beside the radio
                    row. Mobile: the full-width toggle that opens/closes the
                    filter panel, with a +/- affordance on the right. */}
                <button
                    id="filters-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls="exp-filters"
                    data-nav-key="filters-label"
                    data-nav-state="static"
                    class="cart-dim col-span-3 max-md:col-span-12 bg-black text-grey flex items-center max-md:justify-between w-full px-1.5 py-1.5 rounded-xs h-8 max-md:h-11 max-md:px-2.5 max-md:py-[0.9375rem]"
                >
                    <span>Filters</span>
                    <span id="filters-toggle-sign" class="md:hidden" aria-hidden="true">
                        +
                    </span>
                </button>
                {/* Desktop: an inline row of radios inside the nav. Mobile: a
                    panel that opens above the toggle — lifted out of the grid
                    and parked on the nav's top edge (see the style block) so its
                    translucent fill blurs page content, not the nav's white. */}
                <fieldset
                    id="exp-filters"

                    data-nav-key="filters"
                    data-nav-state="static"
                    data-flicker-step="0.22"
                    class="cart-dim col-span-8 bg-black text-grey flex items-center justify-between w-full px-2 py-1.5 rounded-xs h-8 max-md:h-auto max-md:flex-col max-md:items-stretch max-md:gap-[0.9375rem] max-md:px-2.5 max-md:py-[0.9375rem] max-md:bg-[#E0E0E0]/60 max-md:text-black max-md:backdrop-blur-[4px]"
                >
                    {filters.map((label, i) => (
                        <label class="group flex items-center gap-1 cursor-pointer select-none max-md:w-full max-md:flex-row-reverse max-md:justify-between">
                            <input
                                type="radio"
                                name="exp-filter"
                                value={label.toLowerCase()}
                                checked={i === 0}
                                class="appearance-none w-2.5 h-2.5 rounded-full bg-grey outline-none cursor-pointer checked:bg-[radial-gradient(circle,var(--color-black)_0_35%,var(--color-grey)_40%)]"
                            />
                            <span class="transition-opacity group-hover:opacity-60">
                                {label}
                            </span>
                        </label>
                    ))}
                </fieldset>
                <button
                    id="exp-reset"
                    type="button"
                    data-nav-key="reset"
                    data-nav-state="static"
                    class="cart-dim col-span-1 max-md:hidden bg-black text-grey flex items-center justify-start w-full px-1.5 py-1.5 rounded-xs h-8 transition-colors hover:bg-grey hover:text-black"
                >
                    Reset
                </button>
            </>
        )
    }
    {
        showShop &&
            products.map((p) => (
                <a
                    href={`/shop/${p.slug}`}

                    data-nav-key={`shop-${p.slug}`}
                    data-nav-state={
                        currentSlug === null || p.slug === currentSlug
                            ? "on"
                            : "off"
                    }
                    aria-current={p.slug === currentSlug ? "page" : undefined}
                    class:list={[
                        "cart-dim col-span-4 flex items-center justify-start w-full px-1.5 py-1.5 rounded-xs h-8 max-md:h-11 max-md:px-2.5 max-md:py-[0.9375rem] transition-colors",
                        // On the shop index under `md`, each card labels itself
                        // with its name and price, so this row is redundant.
                        // Product pages keep it as the way between products.
                        currentSlug === null && "max-md:hidden",
                        currentSlug === null || p.slug === currentSlug
                            ? "bg-black text-grey"
                            : "bg-grey text-black",
                        // No hover on the active product; others invert.
                        p.slug !== currentSlug &&
                            (currentSlug === null
                                ? "hover:bg-grey hover:text-black"
                                : "hover:bg-black hover:text-grey"),
                    ]}
                >
                    <span>{p.name}</span>

                </a>
            ))
    }
    {
        showArchive &&
            collections.map((c) => (
                <a
                    href={`/archive/${c.slug}`}
                    data-nav-key={`archive-${c.slug}`}
                    data-nav-state={
                        currentArchiveSlug === null ||
                        c.slug === currentArchiveSlug
                            ? "on"
                            : "off"
                    }
                    aria-current={
                        c.slug === currentArchiveSlug ? "page" : undefined
                    }
                    class:list={[
                        "cart-dim col-span-4 flex items-center w-full px-1.5 py-1.5 rounded-xs h-8 max-md:h-11 max-md:px-2.5 max-md:py-[0.9375rem] transition-colors",
                        // Mirrors the shop row: hidden on the archive index
                        // under `md`, where the cards carry their own titles.
                        currentArchiveSlug === null && "max-md:hidden",
                        currentArchiveSlug === null ||
                        c.slug === currentArchiveSlug
                            ? "bg-black text-grey"
                            : "bg-grey text-black",
                        // No hover on the active collection; others invert.
                        c.slug !== currentArchiveSlug &&
                            (currentArchiveSlug === null
                                ? "hover:bg-grey hover:text-black"
                                : "hover:bg-black hover:text-grey"),
                    ]}
                >
                    <span>{c.title}</span>
                </a>
            ))
    }
    {
        navItems.map(({ label, href }) =>
            label === "Shop" ? (
                <a
                    id="shop-nav"
                    href={href}
                    data-nav-key="nav-shop"
                    data-nav-state={isActive(href) ? "on" : "off"}
                    aria-current={isActive(href) ? "page" : undefined}
                    class:list={[
                        "col-start-1 col-span-3 flex items-center w-full px-1.5 py-1.5 rounded-xs h-8 max-md:h-11 max-md:px-2.5 max-md:py-[0.9375rem] transition-colors hover:bg-black hover:text-grey",
                        isActive(href) ? "bg-black text-grey" : "bg-grey",
                    ]}
                >
                    <span id="shop-nav-label">Shop</span>
                    <button
                        id="cart-count"
                        type="button"
                        aria-label="Toggle cart"
                        class:list={[
                            // Under `md` the cart lives in #cart-mobile instead.
                            "group hidden max-md:!hidden h-7 px-1.5 -mr-1 gap-1.5 items-center justify-center rounded-xs text-xs leading-none transition-colors",
                            shopActive
                                ? "bg-grey text-black hover:bg-black hover:text-grey"
                                : "bg-black text-grey hover:bg-grey hover:text-black",
                        ]}
                    >
                        <span id="cart-count-label">Cart</span>
                        <span
                            id="cart-count-num"
                            class:list={[
                                "aspect-square h-4 items-center justify-center text-[0.7rem] rounded-xs leading-none transition-colors",
                                // Inverse of the badge — and it flips with the
                                // badge on hover so the contrast is preserved.
                                shopActive
                                    ? "bg-black text-grey group-hover:bg-grey group-hover:text-black"
                                    : "bg-grey text-black group-hover:bg-black group-hover:text-grey",
                            ]}
                        >
                            0
                        </span>
                    </button>
                </a>
            ) : (
                <a
                    href={href}
                    data-nav-key={`nav-${label.toLowerCase()}`}
                    data-nav-state={isActive(href) ? "on" : "off"}
                    aria-current={isActive(href) ? "page" : undefined}
                    class:list={[
                        "cart-dim col-span-3 flex items-center w-full px-1.5 py-1.5 rounded-xs h-8 max-md:h-11 max-md:px-2.5 max-md:py-[0.9375rem] transition-colors hover:bg-black hover:text-grey",
                        isActive(href) ? "bg-black text-grey" : "bg-grey",
                    ]}
                >
                    {label}
                </a>
            ),
        )
    }
    <a
        href="/"

        data-nav-key="nav-home"
        data-nav-state={isHome ? "on" : "off"}
        aria-label="organicblue — home"
        class:list={[
            "cart-dim col-span-12 flex items-center w-full px-1.5 py-1.5 rounded-xs h-8 max-md:h-11 max-md:px-2.5 max-md:py-[0.9375rem] transition-colors  hover:bg-black hover:text-grey",
            isHome ? "bg-black text-grey" : "bg-grey text-black",
        ]}
    >
        <svg
            viewBox="0 0 122.75 9"
            role="img"
            aria-label="organicblue logotype"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            class="h-2.5 w-auto"
        >
            <path
                d="M61.3134 5.83512L62.5206 6.08568C61.5753 8.0446 59.5481 8.48877 57.8511 8.48877C55.1177 8.48877 52.9766 7.07653 52.9766 4.20648C52.9766 1.70088 54.7874 0.00390625 57.8283 0.00390625C59.7303 0.00390625 61.4387 0.653084 62.3498 2.33867L61.1311 2.60062C60.5047 1.42754 59.1722 1.00615 57.8739 1.00615C56.0972 1.00615 54.1838 1.79199 54.1838 4.19509C54.1838 6.43874 55.858 7.48653 58.0105 7.48653C59.1153 7.48653 60.5845 7.21319 61.3134 5.83512Z"
                fill="currentColor"></path>
            <path
                d="M51.9039 8.28093H50.7422V0.240234H51.9039V8.28093Z"
                fill="currentColor"></path>
            <path
                d="M49.4146 8.28093H48.2984L42.0003 1.6297C42.0003 2.75722 42.0003 3.79363 42.0116 4.72753C42.0116 6.322 42.023 7.98481 42.023 8.28093H40.9297V0.240234H42.1028L48.3554 6.88007C48.3554 5.70699 48.3554 4.6592 48.344 3.7139C48.344 2.10804 48.3212 0.445238 48.3212 0.240234H49.4146V8.28093Z"
                fill="currentColor"></path>
            <path
                d="M40.1349 8.28093H38.8137L37.8343 6.29923H32.8914L31.912 8.28093H30.625L34.7934 0.240234H36.012L40.1349 8.28093ZM37.3446 5.37671L35.3742 1.39053L33.3698 5.37671H37.3446Z"
                fill="currentColor"></path>
            <path
                d="M29.5843 8.28313H28.5934V7.17839C28.0353 7.7934 26.885 8.46536 25.0856 8.46536C22.2269 8.46536 20.4844 6.49505 20.4844 4.24001C20.4844 1.90525 22.3294 0.0488281 25.2906 0.0488281C26.8964 0.0488281 28.787 0.663839 29.5387 2.1672L28.4226 2.50887C27.9328 1.80275 27.0103 1.02829 25.3703 1.02829C23.4 1.02829 21.703 2.14442 21.703 4.19445C21.703 6.38116 23.4341 7.50868 25.3361 7.50868C26.4523 7.50868 27.7051 7.03033 28.3087 6.03948C28.5251 5.67503 28.5706 5.4017 28.6276 5.00308H25.0856V4.0464H29.5843V8.28313Z"
