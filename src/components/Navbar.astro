            <path
                d="M20.2479 8.28093H18.756L16.034 5.05782H12.1503V8.28093H11V0.240234H16.4781C17.1729 0.240234 17.4121 0.274402 17.7537 0.365514C18.8471 0.650241 19.4507 1.49303 19.4507 2.59777C19.4507 3.03056 19.3596 4.14669 18.1523 4.6592C17.9359 4.73892 17.7309 4.79587 17.2754 4.87559L20.2479 8.28093ZM12.1389 4.11252H16.1137C16.7743 4.11252 17.5146 4.08974 17.9701 3.52029C18.0954 3.38362 18.2662 3.11028 18.2662 2.64333C18.2662 2.49527 18.2548 2.18777 18.0612 1.85748C17.7309 1.25386 17.1843 1.19692 16.5579 1.19692H12.1389V4.11252Z"
                fill="currentColor"></path>
            <path
                d="M9.77183 4.38807C9.77183 6.63172 8.07486 8.49953 4.92008 8.49953C1.93614 8.49953 0 6.97339 0 4.3539C0 1.47246 2.30059 0.0488281 4.85175 0.0488281C7.23207 0.0488281 9.77183 1.34718 9.77183 4.38807ZM8.62153 4.2514C8.62153 2.80499 7.67624 1.02829 4.85175 1.02829C2.90422 1.02829 1.13891 2.03053 1.13891 4.30835C1.13891 6.30143 2.57393 7.50868 4.94286 7.50868C7.69902 7.50868 8.62153 5.85726 8.62153 4.2514Z"
                fill="currentColor"></path>
            <path
                d="M100.381 8.0446H92.3516V0.00390625H100.051V0.664473H93.1374V3.48897H99.5267V4.17231H93.1374V7.37264H100.381V8.0446Z"
