---
import { getExplorationImages, urlFor } from "../../lib/sanity";
import { getProducts } from "../../lib/products";

// Images are managed in Sanity (explorationImage docs). The `category` field
// (environment | product | prototype | research) becomes the sprite's category.
const docs = await getExplorationImages();

// Map a featured-product slug (set per image in Sanity) to its display name +
// shop URL, so a zoomed-in image can show a "Shop" bar for the product it
// features. Falls back to the slug if the product can't be resolved.
const products = await getProducts();
const productBySlug = new Map(products.map((p) => [p.slug, p]));

// A small thumbnail powers each of the ~100 sphere sprites (fast first paint);
// the high-res `full` is fetched on demand for whichever single sprite the user
// clicks to zoom-lock, so we never download 100 large images up front. Sanity's
// CDN serves WebP/AVIF automatically via auto("format").
const images = docs.map((doc) => {
    const slug = doc.featuredProduct;
    const feature =
        slug && slug !== "none"
            ? { name: productBySlug.get(slug)?.name ?? slug, url: `/shop/${slug}` }
            : null;
    return {
        thumb: urlFor(doc.image).width(640).auto("format").url(),
        full: urlFor(doc.image).width(2000).auto("format").url(),
        category: doc.category,
        feature,
    };
});
---

<div
    class="absolute inset-0 flex items-center justify-center pointer-events-none"
>
</div>
<canvas
    id="web-canvas"
    data-images={JSON.stringify(images)}
    class="absolute inset-0 w-full h-full"></canvas>

{
    /* Featured-product bar. Hidden until you zoom into an image that features a
   shop product; the script then tracks it under the framed image (see
   updateFeatureBar). pointer-events-none lets clicks fall through to the canvas
   except on the Shop button. */
}
<div
    id="feature-bar"
    class="fixed left-0 top-0 z-20 hidden w-0 items-center justify-between gap-1 rounded-xs bg-black px-1.5 py-1.5 h-8 max-md:h-11 max-md:px-2.5 max-md:py-[0.9375rem] pointer-events-none"
>
    <span id="feature-name" class="truncate text-sm text-grey"></span>
    <a
        id="feature-shop"
        href="#"
        class="pointer-events-auto flex h-7 max-md:h-10 -mr-1 max-md:-mr-2 shrink-0 items-center gap-0.5 rounded-xs bg-grey px-1.5 max-md:px-2.5 text-xs leading-none text-black transition-colors hover:bg-black hover:text-grey"
    >
        <span>Shop</span>
        <svg
            viewBox="0 0 10 10"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="h-2.5 w-2.5"
        >
            <path d="M3 7 L7 3 M4.5 3 H7 V5.5"></path>
        </svg>
    </a>
</div>

<script>
    import * as THREE from "three";
    import { OrbitControls } from "three/addons/controls/OrbitControls.js";
    import { gsap } from "gsap";

    type Feature = { name: string; url: string };
    type SceneImage = {
        thumb: string;
        full: string;
        category: string;
        feature: Feature | null;
    };

    let disposeScene: (() => void) | null = null;

    function initScene(canvas: HTMLCanvasElement, images: SceneImage[]) {
        // No canvas-level fade — the scene flickers itself in instead: each
        // sprite blinks on (flashIn) as its texture arrives (see images.forEach).

        // ── Renderer
        const renderer = new THREE.WebGLRenderer({
            canvas,
            // The final frame is a full-screen quad, so the default framebuffer
            // has no geometry edges to anti-alias — renderer AA here is wasted
            // cost. The real AA lives on the off-screen sceneTarget (MSAA below).
            antialias: false,
            alpha: true,
            powerPreference: "high-performance",
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);

        // ── Scene & camera
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(
            55,
            canvas.clientWidth / canvas.clientHeight,
            0.1,
            100,
        );
        // Placeholder only: the intro tween near startLoop overwrites this on
        // the same tick with a pulled-back start, then dollies in to the
        // viewport's fit distance (see fitDistance).
        camera.position.z = 5;

        // ── Motion blur: a directional *radial* (zoom) blur. The scene is drawn
        //    to an off-screen target, then a full-screen quad re-samples it,
        //    streaking each pixel toward (zoom-in) or away from (zoom-out) the
        //    frame centre. Strength is driven by dolly speed — how fast the
        //    camera distance is changing — so pure orbiting stays sharp and the
        //    streak only appears on a zoom. The output quad uses NoBlending and
        //    we clear every frame, so unlike EffectComposer nothing can trail.
        renderer.setClearColor(0x000000, 0);
        const BLUR_K = 0.4; // dolly-speed → streak-strength gain
        const BLUR_MAX = 0.02; // ceiling on streak (fraction of frame; subtle)
        const BLUR_SAMPLES = 16; // taps along the streak — dense = smooth, not a copy
        let prevDist = camera.position.length();
        let blurStrength = 0;

        const dbSize = renderer.getDrawingBufferSize(new THREE.Vector2());
        const sceneTarget = new THREE.WebGLRenderTarget(dbSize.x, dbSize.y, {
            minFilter: THREE.LinearFilter,
            magFilter: THREE.LinearFilter,
            // 2× MSAA keeps edges clean through the off-screen hop at roughly half
            // the resolve cost of 4× — the biggest steady GPU saving, especially
            // on Firefox where the MSAA resolve is comparatively expensive.
            samples: 2,
        });
        // The scene is written into this target in linear working space, and we
        // sample it raw, so we re-encode ourselves in the shader (see `grade`).
        sceneTarget.texture.colorSpace = THREE.LinearSRGBColorSpace;

        const blurScene = new THREE.Scene();
        const blurCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

        // Rendering the scene to an off-screen target skips the extra sRGB encode
        // the old direct-to-canvas render applied, which made the images look
        // punchier. `grade` re-applies that soft encode partway to taste:
        // 0 = raw/punchy, 1 = the original softer look. Both the passthrough and
        // blur materials share it, so the look never pops when the blur kicks in.
        const CONTRAST_MIX = 0.5;
        // Grade the *true* colour: the target is premultiplied (colour × alpha),
        // so we un-premultiply, apply the soft-encode curve, then re-premultiply
        // with alpha untouched. Running pow() straight on premultiplied RGB
        // would over-brighten low-alpha pixels (sprite edges, blur-streak tails)
        // into a fringe that reads as a ghost/duplicate behind each image.
        const GRADE = /* glsl */ `
            vec4 grade(vec4 c) {
                if (c.a <= 0.0) return c;
                vec3 s = c.rgb / c.a;
                vec3 soft = pow(max(s, 0.0), vec3(1.0 / 2.2));
                return vec4(mix(s, soft, float(${CONTRAST_MIX})) * c.a, c.a);
            }
        `;
        const VERT = /* glsl */ `
            varying vec2 vUv;
            void main() {
                vUv = uv;
                gl_Position = vec4(position.xy, 0.0, 1.0);
            }
        `;
        const noBlend = {
            blending: THREE.NoBlending, // overwrite the canvas fully — no trail
            depthTest: false,
            depthWrite: false,
        } as const;

        // Cheap path: a single tap + grade. Used whenever the camera isn't
        // zooming (i.e. almost always) so idle frames skip the multi-tap loop.
        const passMat = new THREE.ShaderMaterial({
            ...noBlend,
            uniforms: { tScene: { value: sceneTarget.texture } },
            vertexShader: VERT,
            fragmentShader: /* glsl */ `
                uniform sampler2D tScene;
                varying vec2 vUv;
                ${GRADE}
                void main() {
                    gl_FragColor = grade(texture2D(tScene, vUv));
                }
            `,
        });

        // Blur path: N taps along the streak + grade. Only bound while zooming.
        const blurMat = new THREE.ShaderMaterial({
            ...noBlend,
            uniforms: {
                tScene: { value: sceneTarget.texture },
                uStrength: { value: 0 }, // signed: + streaks toward centre
                uCenter: { value: new THREE.Vector2(0.5, 0.5) },
            },
            vertexShader: VERT,
            fragmentShader: /* glsl */ `
                uniform sampler2D tScene;
                uniform float uStrength;
                uniform vec2 uCenter;
                varying vec2 vUv;
                ${GRADE}
                void main() {
                    vec2 dir = (uCenter - vUv) * uStrength;
                    vec4 sum = vec4(0.0);
                    for (int i = 0; i < ${BLUR_SAMPLES}; i++) {
                        float t = float(i) / float(${BLUR_SAMPLES} - 1); // 0..1
                        sum += texture2D(tScene, vUv + dir * t);
                    }
                    gl_FragColor = grade(sum / float(${BLUR_SAMPLES}));
                }
            `,
        });
        const blurQuad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), passMat);
        blurScene.add(blurQuad);

        // ── Controls
        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true;
        controls.enablePan = false;
        // Rotation is ours, not OrbitControls'. It orbits the camera in
        // spherical coordinates and clamps the polar angle to (0, PI) — via
        // Spherical.makeSafe(), which no option can widen — so a vertical drag
        // always stops dead at the poles. Instead we spin the sphere group
        // itself on camera-relative world axes (see rotateGroup), which composes
        // without a pole to hit. OrbitControls keeps the dolly.
        controls.enableRotate = false;
        controls.dampingFactor = 0.04;
        controls.minDistance = 0;
        controls.maxDistance = 10;
        // Locked during the intro so a drag/zoom can't fight the load-in dolly;
        // re-enabled when that tween completes (see the intro tween near startLoop).
        controls.enabled = false;

        // Track real user interaction (drag start/end) rather than every damped
        // "change" frame — otherwise the coast-to-stop keeps resetting the timer
        // and auto-rotation takes far too long to resume.
        // Seed in the past so the idle-rotation gate (> 1200ms since the last
        // interaction) is already open at load — the sphere spins from frame one,
        // rotating through the intro zoom rather than waiting to spin up.
        let lastInteractionTime = Date.now() - 2000;
        let interacting = false;

        // Wheel-zoom (dolly) should NOT pause auto-rotation — only a rotate drag
        // should. OrbitControls fires start/end for wheel too, so mark a brief
        // window around wheel events and skip the interaction gate inside it.
        // Capture phase on window fires before OrbitControls' own canvas-level
        // wheel handler, so the flag is set before the start/end it dispatches.
        let wheeling = false;
        let wheelClear: ReturnType<typeof setTimeout> | undefined;
        const onWheel = (e: WheelEvent) => {
            const wasWheeling = wheeling;
            wheeling = true;
            clearTimeout(wheelClear);
            wheelClear = setTimeout(() => {
                wheeling = false;
            }, 200);
            // While zoomed in the dolly is locked, so a scroll to zoom out
            // instead exits the view — same as a click/tap out. Fire only on the
            // leading edge of a scroll gesture so one gesture is one exit step
            // (a wheel gesture emits a burst of events); otherwise the burst
            // would blow straight through the inner retreat into the full exit.
            if (!wasWheeling && zoomed && !zoomTweening && e.deltaY > 0)
                zoomOut();
        };
        window.addEventListener("wheel", onWheel, {
            passive: true,
            capture: true,
        });

        controls.addEventListener("start", () => {
            if (wheeling) return;
            interacting = true;
        });
        controls.addEventListener("end", () => {
            if (wheeling) return;
            interacting = false;
            lastInteractionTime = Date.now();
        });

        // ── Zoom-to-image state. Zooming flies the camera up close to a sprite
        //    and looks straight at it. Which face was clicked decides the side:
        //    the outer face (pointing away from the centre) is viewed from
        //    outside the shell looking in; the inner face (pointing toward the
        //    centre) is viewed from inside the shell looking out.
        //    `zoomTweening` is the brief fly (zoom-in / hop / zoom-out) during
        //    which GSAP owns the camera and controls are off. `zoomingOut` marks
        //    the flyback so the sphere spins during it.
        let zoomed = false;
        let zoomingOut = false;
        let zoomTweening = false;
        let zoomedSprite: THREE.Sprite | null = null;
        // Which face was clicked, kept across hops: +1 = outer (camera outside
        // the shell, looking inward), -1 = inner (camera inside, looking out).
        let zoomSide = 1;
        let zoomInward = true; // == (zoomSide === 1); cached for the pan loop
        // Once a zoom settles we orbit the camera around the sphere centre
        // ourselves (OrbitControls can't look outward from inside), so panning
        // works for both faces. These are the live + target spherical angles of
        // the camera about the centre, damped toward the targets each frame.
        let panRadius = camera.position.length();
        let panAz = 0;
        let panPol = Math.PI / 2;
        let panAzTarget = 0;
        let panPolTarget = Math.PI / 2;
        let panDragging = false;
        let lastPan = { x: 0, y: 0 };
        const _sph = new THREE.Spherical();
        const lookTarget = new THREE.Vector3(0, 0, 0);
        let savedCamPos = camera.position.clone(); // overview pose to fly back to
        // Inner-face exit rotates the aim by slerping the camera quaternion
        // (see zoomOut) rather than tweening a look point, which would drag the
        // aim through the camera. While true, the render loop leaves the camera
        // orientation to that slerp instead of calling lookAt.
        let aimSlerp = false;
        const exitQ0 = new THREE.Quaternion();
        const exitQ1 = new THREE.Quaternion();
        // Inner-face exit is two-stage: first retreat to near the centre while
        // still looking outward (this flag marks that resting state), then a
        // further zoom-out flies fully back to the outside overview.
        let innerCentered = false;

        // ── Web group
        const group = new THREE.Group();
        scene.add(group);

        // ── Fibonacci-sphere layout, parameterised by node count
        const SPHERE_R = 2.55;
        const MIN_R = 1.65;

        // Keep the spacing between neighbouring sprites roughly constant no
        // matter how many are shown: nearest-neighbour distance scales like
        // R / sqrt(count), so R must scale like sqrt(count) to hold it steady.
        // A floor stops very small sets from collapsing onto the camera.
        function radiusFor(count: number): number {
            if (count <= 1) return SPHERE_R;
            const r = SPHERE_R * Math.sqrt(count / images.length);
            return Math.max(r, MIN_R);
        }

        function fibonacciNodes(
            count: number,
            radius = SPHERE_R,
        ): THREE.Vector3[] {
            const out: THREE.Vector3[] = [];
            for (let i = 0; i < count; i++) {
                const phi = Math.acos(1 - (2 * (i + 0.5)) / count);
                const theta = Math.PI * (1 + Math.sqrt(5)) * i;
                out.push(
                    new THREE.Vector3(
                        radius * Math.sin(phi) * Math.cos(theta),
                        radius * Math.sin(phi) * Math.sin(theta),
                        radius * Math.cos(phi),
                    ),
                );
            }
            return out;
        }

        // ── Edges — connect each node to its 3 nearest neighbours
        function computeEdges(pts: THREE.Vector3[]): number[] {
            const seen = new Set<string>();
            const positions: number[] = [];
            for (let i = 0; i < pts.length; i++) {
                const sorted = pts
                    .map((n, j) => ({ j, d: pts[i].distanceTo(n) }))
                    .filter(({ j }) => j !== i)
                    .sort((a, b) => a.d - b.d);
                for (let k = 0; k < Math.min(3, sorted.length); k++) {
                    const { j } = sorted[k];
                    const key = `${Math.min(i, j)}-${Math.max(i, j)}`;
                    if (!seen.has(key)) {
                        seen.add(key);
                        positions.push(
                            pts[i].x,
                            pts[i].y,
                            pts[i].z,
                            pts[j].x,
                            pts[j].y,
                            pts[j].z,
                        );
                    }
                }
            }
            return positions;
        }

        // Full-set layout (the "all" state).
        const allNodes = fibonacciNodes(images.length);
        const fullEdges = computeEdges(allNodes);

        // Images arrive grouped by folder (environment, product, …), so filling
        // the sphere in index order clumps each category into one region. Give
        // every sprite a shuffled sphere slot instead, to interleave categories.
        // Seeded so the arrangement is stable across reloads (no reshuffle jump).
        function makeSlots(n: number): number[] {
            const slots = Array.from({ length: n }, (_, i) => i);
            let seed = (0x9e3779b9 ^ n) >>> 0;
            const rand = () => {
                seed = (seed + 0x6d2b79f5) | 0;
                let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
                t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
                return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
            for (let i = n - 1; i > 0; i--) {
                const j = Math.floor(rand() * (i + 1));
                [slots[i], slots[j]] = [slots[j], slots[i]];
            }
            return slots;
        }
        const slots = makeSlots(images.length);

        const lineGeo = new THREE.BufferGeometry();
        lineGeo.setAttribute(
            "position",
            new THREE.Float32BufferAttribute(fullEdges, 3),
        );
        const lineMat = new THREE.LineBasicMaterial({
            color: 0x000000,
            transparent: true,
            opacity: 0.2,
        });
        group.add(new THREE.LineSegments(lineGeo, lineMat));

        function setEdges(positions: number[]) {
            lineGeo.setAttribute(
                "position",
                new THREE.Float32BufferAttribute(positions, 3),
            );
            lineGeo.computeBoundingSphere();
        }

        // ── Sprites — one per image, auto-billboarded
        const SPRITE_H = 0.55;

        // ── Overview framing
        //    Distance at which the whole sphere sits inside the frame. The
        //    envelope is the shell plus the sprites standing off it — they're
        //    billboards, so a full sprite height of margin covers the worst
        //    case where one faces us edge-on at the silhouette.
        //
        //    Which axis is tighter depends on the viewport: a wide desktop
        //    canvas is bounded by the vertical FOV, but the horizontal
        //    half-angle narrows with the aspect ratio, so a portrait phone is
        //    bounded horizontally and has to pull back much further. Computing
        //    it per-viewport is what makes the sphere fit at both.
        const FIT_MARGIN = SPRITE_H;
        function fitDistance() {
            const vHalf = THREE.MathUtils.degToRad(camera.fov) / 2;
            const hHalf = Math.atan(Math.tan(vHalf) * camera.aspect);
            return (SPHERE_R + FIT_MARGIN) / Math.sin(Math.min(vHalf, hHalf));
        }
        // Dolly ceiling, with headroom so you can still pull back past the fit.
        const maxDollyDistance = () => fitDistance() * 1.6;

        const sprites: THREE.Sprite[] = [];
        // Subset that features a shop product — the feature bar tracks whichever
        // of these is nearest the viewport centre while zoomed (see updateFeatureBar).
        const featuredSprites: THREE.Sprite[] = [];
        const loader = new THREE.TextureLoader();

        // ── Proximity fade — as the camera pushes through the sphere shell a
        //    sprite it's approaching dissolves instead of hard-clipping, so it
        //    reads as passing *through* the image. Each sprite carries a base
        //    `opacity` (driven by the layout tweens below); the render loop
        //    multiplies that by a distance factor so the two never fight.
        const FADE_NEAR = 0.15; // fully transparent at/under this camera distance
        const FADE_FAR = 0.9; // fully opaque beyond this
        const fadeFor = (dist: number) => {
            const t = Math.min(
                Math.max((dist - FADE_NEAR) / (FADE_FAR - FADE_NEAR), 0),
                1,
            );
            return t * t * (3 - 2 * t); // smoothstep
        };

        // ── Category filtering — `all` is the full sphere; a category re-packs
        //    just its images into a smaller sphere and relinks only those.
        let currentFilter = "all";

        // Transition timings (seconds). T_MOVE/T_FADE_* drive the instant
        // (non-animated) layout path used for initial + streaming loads.
        const T_MOVE = 1.0;
        const T_FADE_OUT = 0.4;
        const T_FADE_IN = 0.6;

        // Flash transition (used for every animated filter change now — category
        // ↔ category and all ↔ filter alike). Nothing glides: the outgoing set
        // blinks out, the incoming set blinks in, and images that persist across
        // the change blink out, reposition while invisible, then blink back in.
        const FLASH_OUT_DUR = 0.1;
        const FLASH_IN_DUR = 0.2;
        const FLASH_OUT_STEP = 0.022; // stagger between leaving sprites
        const FLASH_IN_STEP = 0.032; // stagger between arriving sprites
        const FLASH_IN_LEAD = 0.2; // arrive wave waits this long for the clear-out
        // Cap on how long a wave takes to sweep its whole set, so the big all↔
        // filter sets stay as snappy as a ~25-image category (small sets, which
        // never hit the cap, keep the exact per-item feel you tuned).
        const MAX_WAVE = 1;

        const mat = (s: THREE.Sprite) => s.material as THREE.SpriteMaterial;

        // A sprite that's leaving the current view fades out where it stands —
        // no flight across the sphere — then drops out of rendering.
        function hideSprite(s: THREE.Sprite, animate: boolean) {
            gsap.killTweensOf(s.position);
            if (!animate) {
                s.userData.opacity = 0;
                s.visible = false;
                return;
            }
            gsap.killTweensOf(s.userData);
            gsap.to(s.userData, {
                opacity: 0,
                duration: T_FADE_OUT,
                ease: "power2.in",
                onComplete: () => {
                    s.visible = false;
                },
            });
        }

        // A sprite already on screen glides to its new slot.
        function moveSprite(
            s: THREE.Sprite,
            target: THREE.Vector3,
            animate: boolean,
        ) {
            if (!animate) {
                s.position.copy(target);
                s.userData.opacity = 1;
                return;
            }
            gsap.to(s.position, {
                x: target.x,
                y: target.y,
                z: target.z,
                duration: T_MOVE,
                ease: "power2.inOut",
            });
            gsap.killTweensOf(s.userData);
            gsap.to(s.userData, {
                opacity: 1,
                duration: T_FADE_IN,
                ease: "power2.out",
            });
        }

        // A sprite entering the view materialises directly at its target slot
        // and fades + scales in — so it never streaks in from the far side.
        function revealSprite(
            s: THREE.Sprite,
            target: THREE.Vector3,
            animate: boolean,
        ) {
            gsap.killTweensOf(s.position);
            gsap.killTweensOf(s.userData);
            gsap.killTweensOf(s.scale);
            s.position.copy(target);
            s.visible = true;
            const base = s.userData.baseScale as THREE.Vector3;
            if (!animate) {
                s.userData.opacity = 1;
                s.scale.copy(base);
                return;
            }
            s.userData.opacity = 0;
            s.scale.set(base.x * 0.7, base.y * 0.7, 1);
            gsap.to(s.userData, {
                opacity: 1,
                duration: T_FADE_IN,
                ease: "power2.out",
            });
            gsap.to(s.scale, {
                x: base.x,
                y: base.y,
                duration: T_FADE_IN,
                ease: "back.out(1.4)",
            });
        }

        // Flash-out: a leaving sprite blinks out in place (no move, no scale)
        // with a short flicker, offset by `delay` (its slot in the wave).
        function flashOut(s: THREE.Sprite, delay: number) {
            gsap.killTweensOf(s.position);
            gsap.killTweensOf(s.userData);
            gsap.killTweensOf(s.scale);
            s.scale.copy(s.userData.baseScale as THREE.Vector3);
            gsap.to(s.userData, {
                keyframes: {
                    opacity: [s.userData.opacity as number, 0.35, 0.7, 0],
                    easeEach: "power1.inOut",
                },
                duration: FLASH_OUT_DUR,
                delay: delay + Math.random() * 0.03,
                onComplete: () => {
                    s.visible = false;
                },
            });
        }

        // Flash-in: an entering sprite materialises at its slot (no scale) and
        // blinks on — full, a quick dip, then full — offset by `delay`.
        function flashIn(s: THREE.Sprite, target: THREE.Vector3, delay: number) {
            gsap.killTweensOf(s.position);
            gsap.killTweensOf(s.userData);
            gsap.killTweensOf(s.scale);
            s.position.copy(target);
            s.scale.copy(s.userData.baseScale as THREE.Vector3);
            s.userData.opacity = 0;
            s.visible = true;
            gsap.to(s.userData, {
                keyframes: {
                    opacity: [0, 1, 0.4, 1],
                    easeEach: "power1.inOut",
                },
                duration: FLASH_IN_DUR,
                delay: delay + Math.random() * 0.04,
            });
        }

        // Blink-reposition: a sprite that persists across the change (e.g. the
        // active category when going to/from `all`) can't just glide without
        // reading as "movement", so it blinks out, teleports to its new slot
        // while invisible, then blinks back in — same flicker language, no glide.
        function blinkReposition(
            s: THREE.Sprite,
            target: THREE.Vector3,
            delay: number,
        ) {
            gsap.killTweensOf(s.position);
            gsap.killTweensOf(s.userData);
            gsap.killTweensOf(s.scale);
            s.scale.copy(s.userData.baseScale as THREE.Vector3);
            s.visible = true;
            gsap
                .timeline({ delay })
                .to(s.userData, {
                    keyframes: {
                        opacity: [s.userData.opacity as number, 0.35, 0],
                        easeEach: "power1.inOut",
                    },
                    duration: FLASH_OUT_DUR,
                })
                .add(() => s.position.copy(target)) // move under cover of black
                .to(s.userData, {
                    keyframes: { opacity: [0, 1, 0.4, 1], easeEach: "power1.inOut" },
                    duration: FLASH_IN_DUR,
                });
        }

        function applyEdges(
            positions: number[],
            animate: boolean,
            quick = false,
        ) {
            if (!animate) {
                setEdges(positions);
                lineMat.opacity = 0.3;
                return;
            }
            // Fade the web out, swap links once the sprites have settled, fade
            // in. The flash transition is snappier, so the swap comes sooner.
            const swapAt = quick ? 0.4 : 1.0;
            gsap.to(lineMat, { opacity: 0, duration: 0.3, ease: "power2.out" });
            gsap.delayedCall(swapAt, () => {
                setEdges(positions);
                gsap.to(lineMat, {
                    opacity: 0.2,
                    duration: 0.6,
                    ease: "power2.out",
                });
            });
        }

        function relayout(animate: boolean) {
            // Resolve which sprites are shown and where each one lands. `order`
            // records each shown sprite's slot in its layout (packed spiral for a
            // category, top-to-bottom for `all`); the flash wave staggers by it.
            const targets = new Map<THREE.Sprite, THREE.Vector3>();
            const order = new Map<THREE.Sprite, number>();
            let edges: number[];
            if (currentFilter === "all") {
                sprites.forEach((s) =>
                    targets.set(s, allNodes[s.userData.slot]),
                );
                // Rank by vertical slot position so the wave sweeps top→bottom.
                sprites
                    .slice()
                    .sort(
                        (a, b) =>
                            allNodes[b.userData.slot].y -
                            allNodes[a.userData.slot].y,
                    )
                    .forEach((s, k) => order.set(s, k));
                edges = fullEdges;
            } else {
                const shown = sprites
                    .filter((s) => s.userData.category === currentFilter)
                    .sort((a, b) => a.userData.index - b.userData.index);
                const nodes = fibonacciNodes(
                    shown.length,
                    radiusFor(shown.length),
                );
                shown.forEach((s, k) => {
                    targets.set(s, nodes[k]);
                    order.set(s, k);
                });
                edges = computeEdges(nodes);
            }

            const isHidden = (s: THREE.Sprite) =>
                !s.visible || (s.userData.opacity as number) < 0.05;

            if (animate) {
                // Every animated change is a flash: the outgoing set blinks out
                // top-to-bottom, then the incoming set blinks in. Sprites that
                // persist (a category kept across an all↔filter switch) blink
                // out → reposition → blink in, so nothing ever visibly glides.
                const leavers = sprites.filter(
                    (s) => !targets.get(s) && !isHidden(s),
                );
                leavers.sort((a, b) => b.position.y - a.position.y);
                const outStep = Math.min(
                    FLASH_OUT_STEP,
                    MAX_WAVE / Math.max(leavers.length - 1, 1),
                );
                leavers.forEach((s, i) => flashOut(s, i * outStep));

                // Arriving sprites (everything in the new layout), in wave order.
                const arrivers = sprites
                    .filter((s) => targets.get(s))
                    .sort((a, b) => (order.get(a) ?? 0) - (order.get(b) ?? 0));
                const inStep = Math.min(
                    FLASH_IN_STEP,
                    MAX_WAVE / Math.max(arrivers.length - 1, 1),
                );
                arrivers.forEach((s, i) => {
                    const target = targets.get(s)!;
                    const delay = FLASH_IN_LEAD + i * inStep;
                    if (isHidden(s)) flashIn(s, target, delay);
                    else blinkReposition(s, target, delay);
                });
            } else {
                // Instant (no animation): initial layout / streaming loads.
                sprites.forEach((s) => {
                    const target = targets.get(s);
                    if (!target) {
                        hideSprite(s, false);
                        return;
                    }
                    if (isHidden(s)) revealSprite(s, target, false);
                    else moveSprite(s, target, false);
                });
            }

            applyEdges(edges, animate, true);
        }

        // Intro: instead of flickering each sprite in as its texture lands (a
        // scattered, network-order wave), hold them hidden while they stream in,
        // then fire a single relayout(true) — the same top-down cascade the
        // filter → all switch uses. Stragglers arriving after the cascade has
        // already run just flash in on their own.
        let introDone = false;
        let introLoaded = 0;
        let introTimer: ReturnType<typeof setTimeout>;
        const runIntro = () => {
            if (introDone) return;
            introDone = true;
            clearTimeout(introTimer);
            relayout(true);
        };
        // Safety net: if some textures never arrive, cascade with whatever's in
        // after a short wait so the scene isn't held hostage by one slow image.
        introTimer = setTimeout(runIntro, 1500);

        images.forEach(({ thumb, full, category, feature }, i) => {
            loader.load(thumb, (texture) => {
                const aspect = texture.image.width / texture.image.height;
                const sprite = new THREE.Sprite(
                    new THREE.SpriteMaterial({
                        map: texture,
                        transparent: true,
                    }),
                );
                sprite.position.copy(allNodes[slots[i]]);
                sprite.scale.set(SPRITE_H * aspect, SPRITE_H, 1);
                sprite.userData = {
                    url: full,
                    index: i,
                    slot: slots[i],
                    category,
                    feature, // { name, url } if this image features a product
                    baseScale: sprite.scale.clone(),
                    opacity: 1, // base opacity; render loop scales it by proximity
                    thumbTex: texture, // low-res map, restored on zoom-out
                    hiTex: null as THREE.Texture | null, // high-res, loaded on zoom
                };
                group.add(sprite);
                sprites.push(sprite);
                if (feature) featuredSprites.push(sprite);

                if (!introDone) {
                    // Hold hidden until the whole set is in; runIntro then flashes
                    // everything on top-down at once.
                    sprite.visible = false;
                    sprite.userData.opacity = 0;
                    if (++introLoaded >= images.length) runIntro();
                    return;
                }

                sprite.visible =
                    currentFilter === "all" || category === currentFilter;
                // If a category is active while textures still stream in, fold
                // newly-loaded matches into the packed layout first.
                if (currentFilter !== "all" && category === currentFilter) {
                    relayout(false);
                }
                // Arrived after the intro cascade — flash it in on its own.
                if (sprite.visible) {
                    flashIn(sprite, sprite.position.clone(), Math.random() * 0.2);
                }
            });
        });

        const onFilter = (e: Event) => {
            // A filter chosen mid-load ends the intro: cascade whatever's in and
            // let any stragglers flash in normally afterwards.
            introDone = true;
            clearTimeout(introTimer);
            currentFilter = (e as CustomEvent<{ category: string }>).detail
                .category;
            relayout(true);
        };
        window.addEventListener("filter:change", onFilter);

        // Swap in the high-res texture for a sprite once it lands — unless the
        // user has zoomed back out or moved onto another image by then.
        function loadHiRes(sprite: THREE.Sprite) {
            if (sprite.userData.hiTex) return;
            loader.load(sprite.userData.url as string, (tex) => {
                if (!zoomed || zoomedSprite !== sprite) {
                    tex.dispose();
                    return;
                }
                const thumbTex = sprite.userData.thumbTex as THREE.Texture;
                tex.colorSpace = thumbTex.colorSpace;
                tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
                sprite.userData.hiTex = tex;
                mat(sprite).map = tex;
                mat(sprite).needsUpdate = true;
            });
        }

        // Drop a sprite's high-res texture back to its thumbnail so GPU memory
        // stays flat no matter how many images get inspected.
        function releaseHiRes(sprite: THREE.Sprite) {
            if (!sprite.userData.hiTex) return;
            mat(sprite).map = sprite.userData.thumbTex as THREE.Texture;
            mat(sprite).needsUpdate = true;
            (sprite.userData.hiTex as THREE.Texture).dispose();
            sprite.userData.hiTex = null;
        }

        // ── Zoom the camera in on a clicked sprite, framing it centre-screen.
        //    We sit the camera on the line from the centre out through the sprite
        //    and look straight at the sprite. The clicked face picks the side:
        //    the outer face puts the camera further out (looking inward), the
        //    inner face puts it inside the shell (looking outward). Once the fly
        //    settles, the render loop takes over and orbits the camera around the
        //    centre so the user can pan across the surface at that zoom level; a
        //    tap on a neighbouring sprite hops straight to it, keeping the side.
        function zoomToSprite(sprite: THREE.Sprite) {
            if (zoomTweening) return; // don't interrupt an in-flight fly
            if (zoomed && zoomedSprite === sprite) return;
            aimSlerp = false; // zoom-in / hops aim via lookTarget, not the slerp
            innerCentered = false; // leaving any centred resting state

            const first = !zoomed;
            if (first) savedCamPos = camera.position.clone();

            // Hopping to a neighbour: let the outgoing image fall back to its
            // thumbnail before we frame the new one.
            if (zoomedSprite && zoomedSprite !== sprite) releaseHiRes(zoomedSprite);

            zoomed = true;
            zoomTweening = true;
            zoomedSprite = sprite;
            controls.enabled = false;
            lastInteractionTime = Date.now();

            loadHiRes(sprite);

            const worldP = new THREE.Vector3();
            sprite.getWorldPosition(worldP);
            const dir = worldP.clone().normalize(); // centre → sprite, outward

            // Begin the aim from wherever the camera is currently looking after
            // any panning, so a hop doesn't snap back to the previous framing
            // before flying to the new sprite. This uses the side we were *already*
            // in, so it must run before we recompute the side below. (The first
            // zoom comes from the overview, whose lookTarget already sits at the
            // centre.)
            if (!first) {
                if (zoomInward) lookTarget.set(0, 0, 0);
                else lookTarget.copy(camera.position).multiplyScalar(2);
            }

            // Distance that fits the whole sprite in view — limited by whichever
            // of width/height is tighter against the frame — plus a little margin.
            const vFov = (camera.fov * Math.PI) / 180;
            const hFov = 2 * Math.atan(Math.tan(vFov / 2) * camera.aspect);
            const distH = sprite.scale.y / 2 / Math.tan(vFov / 2);
            const distW = sprite.scale.x / 2 / Math.tan(hFov / 2);
            const dist = Math.max(distH, distW) * 1.3;

            // Pick the side from which face is toward the camera *now*: the dot is
            // positive when the camera sits on the sprite's outward side (outer
            // face) and negative when it's on the inward side (inner face).
            // Recomputed on every hop — not just the first zoom — so clicking an
            // image whose inner face is showing dives inside to it even if we
            // started outside, and vice-versa. (Panning itself never changes the
            // side, so it can't punch through the shell mid-pan.)
            zoomSide =
                camera.position.clone().sub(worldP).dot(dir) >= 0 ? 1 : -1;
            zoomInward = zoomSide === 1;

            const camGoal = worldP
                .clone()
                .add(dir.clone().multiplyScalar(zoomSide * dist));

            gsap.to(camera.position, {
                x: camGoal.x,
                y: camGoal.y,
                z: camGoal.z,
                duration: first ? 1.1 : 0.9,
                ease: "power2.inOut",
                onComplete: () => {
                    // Seed the orbit-pan angles from where the fly landed so the
                    // hand-off to manual panning is seamless (no jump).
                    _sph.setFromVector3(camera.position);
                    panRadius = _sph.radius;
                    panPol = panPolTarget = _sph.phi;
                    panAz = panAzTarget = _sph.theta;
                    zoomTweening = false;
                },
            });
            // Aim at the sprite through the fly. For the outer face this is the
            // same direction as looking at the centre; for the inner face it
            // looks outward — either way it matches the pan loop's aim on settle.
            gsap.to(lookTarget, {
                x: worldP.x,
                y: worldP.y,
                z: worldP.z,
                duration: first ? 1.1 : 0.9,
                ease: "power2.inOut",
            });
        }

        const NEAR_CENTER = 0.15; // resting radius for the inner-face retreat
        function zoomOut() {
            if (!zoomed || zoomTweening) return;

            // Inner face, not yet pulled in: retreat straight along the current
            // radial to just shy of the centre, keeping the outward look (no
            // rotation — just shrink the pan radius), and stay in the inside
            // look-around mode. Drop the focused sprite so a tap now hops to a
            // new image or, on empty space, triggers the full exit below.
            if (!zoomInward && !innerCentered) {
                innerCentered = true;
                if (zoomedSprite) {
                    releaseHiRes(zoomedSprite);
                    zoomedSprite = null;
                }
                const r = { v: panRadius };
                gsap.to(r, {
                    v: NEAR_CENTER,
                    duration: 1.2,
                    ease: "power2.out",
                    onUpdate: () => {
                        // Ignore once a hop/full-exit has taken over the camera.
                        if (zoomed && !zoomTweening && innerCentered)
                            panRadius = r.v;
                    },
                });
                return;
            }

            // Otherwise fly fully back out to the overview pose.
            zoomingOut = true;
            zoomTweening = true;
            controls.enabled = false;

            if (zoomedSprite) {
                releaseHiRes(zoomedSprite);
                zoomedSprite = null;
            }

            let dest: THREE.Vector3;
            if (zoomInward) {
                // Outer view already looks at the centre — return to the saved
                // overview pose, aim held on the centre by the render loop.
                aimSlerp = false;
                lookTarget.set(0, 0, 0);
                dest = savedCamPos.clone();
            } else {
                // Inside looking out — dolly straight back along the current view
                // axis (through the centre and out the far side) with the aim
                // frozen. The framed image stays put, and once outside "looking
                // outward" is exactly "looking at the centre", so it hands off to
                // OrbitControls with no reposition. Flying toward savedCamPos
                // instead would warp to an unrelated spot — the disorienting jump.
                aimSlerp = true;
                exitQ0.copy(camera.quaternion);
                exitQ1.copy(camera.quaternion); // frozen: no rotation
                dest = camera.position
                    .clone()
                    .normalize()
                    .multiplyScalar(-savedCamPos.length());
            }

            const posTween = gsap.to(camera.position, {
                x: dest.x,
                y: dest.y,
                z: dest.z,
                duration: 1.2,
                ease: "power2.out",
                onUpdate: () => {
                    if (aimSlerp)
                        camera.quaternion.slerpQuaternions(
                            exitQ0,
                            exitQ1,
                            posTween.progress(),
                        );
                },
                onComplete: () => {
                    aimSlerp = false;
                    innerCentered = false;
                    zoomed = false;
                    zoomingOut = false;
                    zoomTweening = false;
                    controls.enabled = true;
                    // Seed in the past so idle rotation carries straight on from
                    // the spin the flyback already had — no 1200ms dead stop.
                    lastInteractionTime = Date.now() - 2000;
                },
            });
        }

        // ── Reset: fly the camera home to the initial overview pose (straight-on,
        //    resting distance) from wherever it is — panned overview, zoomed, or
        //    inside — and hand back to OrbitControls. The aim is slerped so it
        //    never snaps, even when reversing from an inner outward-looking view.
        // Resting distance after the intro dolly — the framing that fits the
        // whole sphere at the current viewport.
        const initialZ = () => fitDistance();
        function resetView() {
            const INITIAL_Z = initialZ();
            gsap.killTweensOf(camera.position);
            gsap.killTweensOf(lookTarget);
            if (zoomedSprite) {
                releaseHiRes(zoomedSprite);
                zoomedSprite = null;
            }

            const dest = new THREE.Vector3(0, 0, INITIAL_Z);
            // Capture the end orientation by momentarily posing the camera home.
            exitQ0.copy(camera.quaternion);
            const keep = camera.position.clone();
            camera.position.copy(dest);
            camera.lookAt(0, 0, 0);
            exitQ1.copy(camera.quaternion);
            camera.position.copy(keep);
            camera.quaternion.copy(exitQ0);

            zoomed = true; // suppress overview auto-rotate/controls during the fly
            zoomingOut = true; // keep the sphere spinning through the flyback
            zoomTweening = true;
            aimSlerp = true;
            innerCentered = false;
            controls.enabled = false;
            controls.minDistance = 0; // restore overview dolly range
            controls.maxDistance = maxDollyDistance();
            lookTarget.set(0, 0, 0);

            const posTween = gsap.to(camera.position, {
                x: dest.x,
                y: dest.y,
                z: dest.z,
                duration: 1.2,
                ease: "power2.inOut",
                onUpdate: () => {
                    camera.quaternion.slerpQuaternions(
                        exitQ0,
                        exitQ1,
                        posTween.progress(),
                    );
                },
                onComplete: () => {
                    aimSlerp = false;
                    zoomed = false;
                    zoomingOut = false;
                    zoomTweening = false;
                    controls.enabled = true;
                    lastInteractionTime = Date.now() - 2000;
                },
            });
        }
        const onReset = () => resetView();
        window.addEventListener("scene:reset", onReset);

        // ── Click detection
        const raycaster = new THREE.Raycaster();
        const pointer = new THREE.Vector2();
        let pointerDown = { x: 0, y: 0 };

        // ── Overview rotation. Spinning the group rather than orbiting the
        //    camera is what makes vertical dragging unbounded: each drag is a
        //    rotation about a camera-relative *world* axis, composed onto the
        //    group's quaternion, so there's no polar angle to clamp and the
        //    sphere tumbles end over end. autoSpin already turns the group this
        //    way, so the two compose without special-casing.
        const DRAG_K = 0.005; // radians per pixel dragged
        const DRAG_DECAY = 0.94; // per-frame coast after release
        const DRAG_EPS = 1e-4; // below this the coast has stopped
        const _dragRight = new THREE.Vector3();
        const _dragUp = new THREE.Vector3();
        let orbitDragging = false;
        let lastDrag = { x: 0, y: 0 };
        let dragVelPitch = 0;
        let dragVelYaw = 0;

        function rotateGroup(pitch: number, yaw: number) {
            _dragRight.set(1, 0, 0).applyQuaternion(camera.quaternion);
            _dragUp.set(0, 1, 0).applyQuaternion(camera.quaternion);
            group.rotateOnWorldAxis(_dragUp, yaw);
            group.rotateOnWorldAxis(_dragRight, pitch);
        }

        const onPointerDown = (e: PointerEvent) => {
            pointerDown = { x: e.clientX, y: e.clientY };
            // While zoomed we drive the camera ourselves, so a drag pans the
            // surface — start tracking it here (OrbitControls is off).
            if (zoomed && !zoomTweening) {
                panDragging = true;
                lastPan = { x: e.clientX, y: e.clientY };
            } else if (!zoomTweening) {
                // Overview: grab the sphere. Kill any coast so the grab is
                // immediate rather than fighting leftover momentum.
                orbitDragging = true;
                interacting = true;
                dragVelPitch = dragVelYaw = 0;
                lastDrag = { x: e.clientX, y: e.clientY };
                // OrbitControls used to capture the pointer for us. Now that the
                // rotation is ours, capture it here too — without this, dragging
                // past the canvas edge strands the drag (no pointerup reaches
                // us) and idle auto-rotation never resumes.
                try {
                    canvas.setPointerCapture(e.pointerId);
                } catch {
                    /* pointer already gone — nothing to capture */
                }
            }
        };
        const onPointerMove = (e: PointerEvent) => {
            if (zoomTweening) return;

            if (orbitDragging) {
                const dx = e.clientX - lastDrag.x;
                const dy = e.clientY - lastDrag.y;
                lastDrag = { x: e.clientX, y: e.clientY };
                // Grab-and-drag: the near face follows the pointer, so dragging
                // right spins it right and dragging down tips it down.
                dragVelPitch = dy * DRAG_K;
                dragVelYaw = dx * DRAG_K;
                rotateGroup(dragVelPitch, dragVelYaw);
                return;
            }

            if (!panDragging) return;
            const dx = e.clientX - lastPan.x;
            const dy = e.clientY - lastPan.y;
            lastPan = { x: e.clientX, y: e.clientY };
            // Orbit the camera around the sphere centre at the locked radius.
            // Looking outward (inner face) reverses the grab-and-drag direction.
            const s = zoomInward ? 1 : -1;
            const k = 0.003;
            panAzTarget -= dx * k * s;
            panPolTarget = Math.min(
                Math.max(panPolTarget - dy * k * s, 0.12),
                Math.PI - 0.12,
            );
        };
        const onPointerUp = (e: PointerEvent) => {
            panDragging = false;
            if (orbitDragging) {
                orbitDragging = false;
                interacting = false;
                lastInteractionTime = Date.now();
                try {
                    canvas.releasePointerCapture(e.pointerId);
                } catch {
                    /* never captured, or already released */
                }
            }
            if (
                Math.hypot(
                    e.clientX - pointerDown.x,
                    e.clientY - pointerDown.y,
                ) > 5
            )
                return;
            // While zoomed in, a tap on a neighbouring image travels to it; a
            // tap on the focused image (or empty space) flies the camera out.
            if (zoomed) {
                if (zoomTweening) return; // don't interrupt an in-flight fly
                const rect = canvas.getBoundingClientRect();
                pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
                raycaster.setFromCamera(pointer, camera);
                const hits = raycaster.intersectObjects(
                    sprites.filter((s) => s.visible),
                );
                // Only the *nearest* image counts — you can't click through the
                // focused one to a sprite behind it. Tapping the focused image
                // (or empty space) flies back out; tapping a nearer neighbour
                // travels to it.
                const hit = hits[0];
                if (hit && hit.object !== zoomedSprite)
                    zoomToSprite(hit.object as THREE.Sprite);
                else zoomOut();
                return;
            }
            // Ignore clicks during the intro (controls stay disabled until the
            // load-in dolly finishes) so a click can't zoom-lock mid-animation.
            if (!controls.enabled) return;
            const rect = canvas.getBoundingClientRect();
            pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
            pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
            raycaster.setFromCamera(pointer, camera);
            const hits = raycaster.intersectObjects(
                sprites.filter((s) => s.visible),
            );
            if (hits.length > 0) {
                zoomToSprite(hits[0].object as THREE.Sprite);
            }
        };

        canvas.addEventListener("pointerdown", onPointerDown);
        canvas.addEventListener("pointermove", onPointerMove);
        canvas.addEventListener("pointerup", onPointerUp);

        // ── Resize. The canvas rect is cached here (the explorations stage is a
        //    fixed full-screen element, so it only changes on resize) and reused
        //    by the per-frame feature-bar positioning to avoid a layout flush
        //    every frame — a getBoundingClientRect in the render loop is a
        //    read/write layout thrash that hits Firefox especially hard.
        let canvasRect = canvas.getBoundingClientRect();
        const ro = new ResizeObserver(() => {
            const w = canvas.clientWidth;
            const h = canvas.clientHeight;
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            // The fit distance moves with the aspect ratio, so the dolly
            // ceiling has to follow it — otherwise rotating a phone to portrait
            // would leave the camera unable to pull back far enough. The camera
            // itself is left where it is; yanking it mid-gesture would be worse
            // than a slightly tight frame until the next reset.
            controls.maxDistance = maxDollyDistance();
            renderer.setSize(w, h, false);
            const db = renderer.getDrawingBufferSize(new THREE.Vector2());
            sceneTarget.setSize(db.x, db.y);
            canvasRect = canvas.getBoundingClientRect();
        });
        ro.observe(canvas);

        // ── Featured-product bar. While zoomed, the bar tracks whichever featured
        //    image is nearest the viewport centre — not just the one you clicked.
        //    It flickers in (shared site language) as an image reaches the centre
        //    area, tracks under it, and fades out as it drifts toward the edges;
        //    pan a different featured image to the centre and its bar takes over
        //    and flickers in. Distances are screen-space (NDC) from centre.
        const featureBar = document.getElementById("feature-bar");
        const featureName = document.getElementById("feature-name");
        const featureShop = document.getElementById(
            "feature-shop",
        ) as HTMLAnchorElement | null;
        const FEATURE_GAP = 2; // px below the image (matches gap-0.5)
        // Centre-zone thresholds (NDC radius). Inside FADE_IN a featured image is
        // "at centre" → its bar is fully shown / flickers in; past FADE_OUT it's
        // dropped. Between them the bar fades with distance. Tunable.
        const FEATURE_FADE_IN = 0.5;
        const FEATURE_FADE_OUT = 1.0;
        const FEATURE_FLICK = [0, 1, 0.4, 1]; // shared flicker-in keyframes
        const reduceMotion = () =>
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let featureActive: THREE.Sprite | null = null;
        let featureFlickering = false;
        const _fbCenter = new THREE.Vector3();
        const _fbRight = new THREE.Vector3();
        const _fbUp = new THREE.Vector3();
        const _fbFwd = new THREE.Vector3();
        const _fbVec = new THREE.Vector3();
        const _fbBL = new THREE.Vector3();
        const _fbBR = new THREE.Vector3();

        // Screen-space distance (NDC) of a featured sprite from the viewport
        // centre, or Infinity if it doesn't currently qualify (not settled-zoomed,
        // hidden, no feature, or behind the camera).
        function featureDist(s: THREE.Sprite): number {
            // Only while actually zoomed into an image — not the inner-centred
            // look-around state (zoomed is still true there, but zoomedSprite is
            // cleared), where bars for surrounding inner images shouldn't show.
            if (!zoomed || zoomTweening || innerCentered) return Infinity;
            if (!s.visible || !s.userData.feature) return Infinity;
            camera.getWorldDirection(_fbFwd);
            s.getWorldPosition(_fbCenter);
            _fbVec.copy(_fbCenter).sub(camera.position);
            if (_fbVec.dot(_fbFwd) <= 0) return Infinity; // behind camera
            // Only images on the shell face we're currently viewing qualify: the
            // sign of (camera → sprite) against the sprite's outward normal is +1
            // for its outer face, -1 for its inner face (same test zoomToSprite
            // uses). Skipping the mismatched side means that from outside the
            // sphere the inner-facing images across it never show a bar.
            _fbBL.copy(_fbCenter).normalize(); // outward normal at the sprite
            const side = -_fbVec.dot(_fbBL) >= 0 ? 1 : -1;
            if (side !== zoomSide) return Infinity;
            _fbCenter.project(camera);
            return Math.hypot(_fbCenter.x, _fbCenter.y);
        }

        // Nearest featured sprite to the viewport centre, written to these shared
        // fields (no per-frame object allocation — this runs every frame).
        let nearestSprite: THREE.Sprite | null = null;
        let nearestDist = Infinity;
        function computeNearestFeatured() {
            nearestSprite = null;
            nearestDist = Infinity;
            for (const s of featuredSprites) {
                const d = featureDist(s);
                if (d < nearestDist) {
                    nearestDist = d;
                    nearestSprite = s;
                }
            }
        }

        // Choose the active sprite with hysteresis: an image at the centre
        // (< FADE_IN) takes over; otherwise the current one is kept while it's
        // still within FADE_OUT, so it fades on the way out instead of popping.
        function pickFeature(): THREE.Sprite | null {
            computeNearestFeatured();
            if (nearestSprite && nearestDist < FEATURE_FADE_IN)
                return nearestSprite;
            if (featureActive && featureDist(featureActive) < FEATURE_FADE_OUT)
                return featureActive;
            return null;
        }

        // Position the bar spanning the sprite's bottom edge, a small gap below.
        function positionFeatureBar(s: THREE.Sprite) {
            if (!featureBar) return;
            camera.updateMatrixWorld();
            _fbRight.setFromMatrixColumn(camera.matrixWorld, 0);
            _fbUp.setFromMatrixColumn(camera.matrixWorld, 1);
            s.getWorldPosition(_fbCenter);
            const hw = s.scale.x / 2;
            const hh = s.scale.y / 2;
            _fbBL.copy(_fbCenter)
                .addScaledVector(_fbRight, -hw)
                .addScaledVector(_fbUp, -hh)
                .project(camera);
            _fbBR.copy(_fbCenter)
                .addScaledVector(_fbRight, hw)
                .addScaledVector(_fbUp, -hh)
                .project(camera);
            const rect = canvasRect; // cached; refreshed on resize
            const blx = (_fbBL.x * 0.5 + 0.5) * rect.width + rect.left;
            const bly = (-_fbBL.y * 0.5 + 0.5) * rect.height + rect.top;
            const brx = (_fbBR.x * 0.5 + 0.5) * rect.width + rect.left;
            featureBar.style.left = `${blx}px`;
            featureBar.style.top = `${bly + FEATURE_GAP}px`;
            featureBar.style.width = `${Math.max(brx - blx, 0)}px`;
        }

        function showFeatureBar() {
            if (!featureBar) return;
            featureBar.classList.remove("hidden");
            featureBar.classList.add("flex");
        }

        function hideFeatureBar() {
            if (!featureBar) return;
            gsap.killTweensOf(featureBar);
            featureBar.classList.add("hidden");
            featureBar.classList.remove("flex");
            featureActive = null;
            featureFlickering = false;
        }

        // Blink the bar in with the shared flicker language. While it plays it
        // owns the bar's opacity; the per-frame edge-fade resumes on completion.
        function flickerFeatureBarIn() {
            if (!featureBar) return;
            gsap.killTweensOf(featureBar);
            if (reduceMotion()) {
                featureFlickering = false;
                featureBar.style.opacity = "1";
                return;
            }
            featureFlickering = true;
            featureBar.style.opacity = "0";
            gsap.to(featureBar, {
                keyframes: { opacity: FEATURE_FLICK, easeEach: "power1.inOut" },
                duration: 0.22,
                onComplete: () => {
                    featureFlickering = false;
                },
            });
        }

        // Fade the bar out (used when no featured image is near the centre, e.g.
        // panned away or on zoom-out) then tear it down.
        function fadeFeatureBarOut() {
            if (!featureBar) return;
            gsap.killTweensOf(featureBar);
            gsap.to(featureBar, {
                opacity: 0,
                duration: 0.2,
                ease: "power2.out",
                onComplete: () => hideFeatureBar(),
            });
        }

        function updateFeatureBar() {
            if (!featureBar || !featureName || !featureShop) return;
            const next = pickFeature();

            if (next !== featureActive) {
                if (next) {
                    const feature = next.userData.feature as Feature;
                    featureName.textContent = feature.name;
                    featureShop.href = feature.url;
                    featureActive = next;
                    showFeatureBar();
                    positionFeatureBar(next);
                    flickerFeatureBarIn();
                } else {
                    featureActive = null;
                    fadeFeatureBarOut();
                }
            }

            if (featureActive) {
                positionFeatureBar(featureActive);
                // Edge-fade with distance from centre (skipped while the flicker
                // tween owns the opacity).
                if (!featureFlickering) {
                    const d = featureDist(featureActive);
                    const t = THREE.MathUtils.clamp(
                        (FEATURE_FADE_OUT - d) /
                            (FEATURE_FADE_OUT - FEATURE_FADE_IN),
                        0,
                        1,
                    );
                    featureBar.style.opacity = String(t * t * (3 - 2 * t));
                }
            }
        }

        // ── Render loop — pauseable so we can free the frame budget during transitions
        let rafId = 0;
        let running = false;

        function startLoop() {
            if (running) return;
            running = true;
            const wp = new THREE.Vector3();
            const spinAxis = new THREE.Vector3();
            const lookOut = new THREE.Vector3(); // reused outward look point (no per-frame alloc)
            const SPIN = 0.0016; // idle auto-rotation speed (radians/frame)
            // Spin about the camera's up axis (screen-vertical in world space)
            // rather than a fixed world axis, so the drift looks the same
            // horizontal way no matter where the camera has panned to.
            const autoSpin = () => {
                spinAxis.set(0, 1, 0).applyQuaternion(camera.quaternion);
                group.rotateOnWorldAxis(spinAxis, SPIN);
            };
            function tick() {
                if (!running) return;
                rafId = requestAnimationFrame(tick);
                if (zoomTweening) {
                    // Camera is being flown by GSAP (zoom-in, hop between images,
                    // or zoom-out flyback); just keep it aimed at the sprite. Keep
                    // the sphere spinning through the flyback so it's already in
                    // motion by the time control hands back to the orbit view.
                    // (The inner-face exit drives the orientation itself via a
                    // quaternion slerp — see zoomOut — so skip lookAt then.)
                    if (!aimSlerp) camera.lookAt(lookTarget);
                    if (zoomingOut) autoSpin();
                } else if (zoomed) {
                    // Settled zoom: orbit the camera around the centre ourselves
                    // (damped toward the drag target) so it pans across the
                    // surface — looking inward for the outer face, outward for the
                    // inner one. OrbitControls can't do the outward case.
                    panAz += (panAzTarget - panAz) * 0.15;
                    panPol += (panPolTarget - panPol) * 0.15;
                    _sph.set(panRadius, panPol, panAz);
                    camera.position.setFromSpherical(_sph);
                    if (zoomInward) camera.lookAt(0, 0, 0);
                    else camera.lookAt(lookOut.copy(camera.position).multiplyScalar(2));
                    // Resting inside at the centre: keep the sphere turning,
                    // paused only while the user is actively dragging to look.
                    if (innerCentered && !panDragging) autoSpin();
                } else {
                    // Overview: OrbitControls own the dolly only — rotation is
                    // the group spin above. A released drag coasts to a stop,
                    // then idle auto-rotation takes back over.
                    controls.update();
                    const coasting =
                        Math.abs(dragVelPitch) > DRAG_EPS ||
                        Math.abs(dragVelYaw) > DRAG_EPS;
                    if (orbitDragging) {
                        // The drag itself already turned the group this frame.
                    } else if (coasting) {
                        rotateGroup(dragVelPitch, dragVelYaw);
                        dragVelPitch *= DRAG_DECAY;
                        dragVelYaw *= DRAG_DECAY;
                    } else if (
                        !interacting &&
                        Date.now() - lastInteractionTime > 500
                    ) {
                        autoSpin();
                    }
                }

                // Track the featured-product bar under the focused image.
                updateFeatureBar();

                // Proximity fade — skip while zoomed so the framed image stays
                // fully opaque even though the camera sits close to it. Also skip
                // the per-sprite distance work when the camera is far enough that
                // every sprite is beyond FADE_FAR (the whole overview, unless the
                // user has wheel-dollied in) — then prox is always 1 and we only
                // need to copy each sprite's gsap-animated base opacity across.
                const proxActive =
                    !zoomed && camera.position.length() < SPHERE_R + FADE_FAR;
                for (const s of sprites) {
                    if (!s.visible) continue;
                    let prox = 1;
                    if (proxActive) {
                        s.getWorldPosition(wp);
                        prox = fadeFor(camera.position.distanceTo(wp));
                    }
                    mat(s).opacity = s.userData.opacity * prox;
                }

                // Streak strength follows dolly speed (how fast the camera
                // distance is changing). Positive when zooming in → streak
                // toward centre; negative when zooming out → streak outward.
                const dist = camera.position.length();
                const dolly = prevDist - dist;
                prevDist = dist;
                const target = THREE.MathUtils.clamp(
                    dolly * BLUR_K,
                    -BLUR_MAX,
                    BLUR_MAX,
                );
                blurStrength += (target - blurStrength) * 0.3;
                if (Math.abs(blurStrength) < 0.0004) blurStrength = 0;

                // Only pay for the multi-tap streak while actually zooming; the
                // rest of the time a single-tap passthrough does the grade.
                if (blurStrength !== 0) {
                    blurQuad.material = blurMat;
                    blurMat.uniforms.uStrength.value = blurStrength;
                } else {
                    blurQuad.material = passMat;
                }

                // Draw the scene off-screen, then re-sample it to the canvas.
                // The explicit clears matter: with an MSAA target, autoClear
                // doesn't reliably wipe the multisample buffer on every driver,
                // and a stale sceneTarget resolves as a camera-tracking ghost.
                renderer.setRenderTarget(sceneTarget);
                renderer.clear();
                renderer.render(scene, camera);
                renderer.setRenderTarget(null);
                renderer.clear();
                renderer.render(blurScene, blurCam);
            }
            tick();
        }

        function stopLoop() {
            running = false;
            cancelAnimationFrame(rafId);
        }

        // Pause automatically when the canvas is off-screen (other sections / other pages)
        const io = new IntersectionObserver(
            ([entry]) => {
                entry.isIntersecting ? startLoop() : stopLoop();
            },
            { threshold: 0.1 },
        );
        io.observe(canvas);
        startLoop();

        // Intro: dolly the camera in from the pulled-back start to the resting
        // distance. OrbitControls derives its spherical from the live camera
        // position each frame, so tweening z is respected; the dolly speed also
        // feeds the radial blur, giving a subtle zoom streak on the way in.
        // The dolly ceiling has to clear the fit distance, or on a portrait
        // viewport — where fitting the sphere needs ~11 units — the old flat
        // limit of 10 would clamp the camera before the sphere was fully in
        // frame, making it impossible to zoom out that far by hand either.
        controls.maxDistance = maxDollyDistance();

        gsap.fromTo(
            camera.position,
            { z: fitDistance() * 1.28 },
            {
                z: fitDistance(),
                duration: 2,
                ease: "power2.out",
                // Hand control back once the load-in dolly finishes so the user
                // can't drag/zoom against it mid-animation.
                onComplete: () => {
                    controls.enabled = true;
                },
            },
        );

        // ── Return teardown
        return () => {
            stopLoop();
            hideFeatureBar();
            io.disconnect();
            ro.disconnect();
            window.removeEventListener("filter:change", onFilter);
            window.removeEventListener("scene:reset", onReset);
            window.removeEventListener("wheel", onWheel, { capture: true });
            clearTimeout(wheelClear);
            clearTimeout(introTimer);
            canvas.removeEventListener("pointerdown", onPointerDown);
            canvas.removeEventListener("pointermove", onPointerMove);
            canvas.removeEventListener("pointerup", onPointerUp);
            // Kill any in-flight relayout tweens/delayed calls so they can't fire
            // against the disposed scene after navigation.
            gsap.killTweensOf(lineMat);
            gsap.killTweensOf(camera.position);
            gsap.killTweensOf(lookTarget);
            sprites.forEach((s) => {
                gsap.killTweensOf(s.position);
                gsap.killTweensOf(s.scale);
                gsap.killTweensOf(s.material);
                gsap.killTweensOf(s.userData);
                (s.userData.hiTex as THREE.Texture | null)?.dispose();
            });
            controls.dispose();
            sceneTarget.dispose();
            blurMat.dispose();
            passMat.dispose();
            blurQuad.geometry.dispose();
            renderer.dispose();
            // Free the WebGL context outright. dispose() alone leaves the context
            // alive; without this, re-initialising (navigating back to this page)
            // stacks contexts until the browser evicts the oldest — a slow leak.
            renderer.forceContextLoss();
        };
    }

    function tryInit() {
        disposeScene?.();
        disposeScene = null;

        const canvas = document.getElementById(
            "web-canvas",
        ) as HTMLCanvasElement | null;
        if (!canvas) return;

        const images: SceneImage[] = JSON.parse(canvas.dataset.images!);

        function attempt() {
            if (!canvas!.isConnected) return;
            if (canvas!.clientWidth === 0 || canvas!.clientHeight === 0) {
                requestAnimationFrame(attempt);
                return;
            }
            disposeScene = initScene(canvas!, images);
        }
        requestAnimationFrame(attempt);
    }

    // Stop the loop the moment navigation begins — frees the frame budget for GSAP
    document.addEventListener("astro:before-swap", () => {
        disposeScene?.();
        disposeScene = null;
    });

    document.addEventListener("astro:page-load", tryInit);
</script>
