---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import { shareImage, shareImageAlt } from "../lib/site";

interface Props {
    title?: string;
    description?: string;
    isHome?: boolean;
}

const {
    title = "Organic Blue",
    description = "Organic Blue is a Montreal-based design studio working across technical garments, objects and spatial experiences.",
    isHome = false,
} = Astro.props;

// Absolute, per-page — scrapers won't resolve a relative og:url.
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <title>{title}</title>
        {/* Open Graph + Twitter, driven by the same title/description above so
           a page that overrides either gets the matching share card for free.
           The image is a still from the homepage film (src/lib/site.ts). */}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Organic Blue" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={shareImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={shareImage} />
        <meta name="twitter:image:alt" content={shareImageAlt} />
        <ClientRouter />
        {/* On the initial hard load, pre-hide the navbar tiles so they flicker
           in cleanly with the rest of the interface instead of painting first.
           The class is dropped after the first sweep; later navigations keep
           persistent tiles visible and only diff what changed. */}
        {/* Root size keyed to the *display*, not the window. Every size on the
           site is rem-based, so this scales the whole interface — most
           visibly the navbar, which otherwise holds a fixed pixel height and
           eats a bigger share of the screen the lower the resolution goes.

           screen.width is the logical width the OS display setting produces:
           it drops when someone picks a scaled resolution and, unlike vw,
           does NOT move when they resize the browser window. A narrowed
           window on a wide display should not shrink the chrome; a display
           scaled to 1440 should. The global.css clamp() is the same ramp in
           vw and stays as the no-JS fallback — this inline style outranks it.

           Runs in <head> so it lands before first paint. */}
        <script is:inline>
            (function () {
                function applyRootScale() {
                    // Under `md` the layout switches to its mobile variants,
                    // where the ramp below bottoms out at its 12px floor and
                    // leaves the type and tap targets smaller than a phone
                    // wants. Give that range its own slightly larger root.
                    // Keyed off the *viewport*, not the display, so it turns
                    // over at the same 768px the max-md: variants do.
                    if (window.innerWidth < 768) {
                        document.documentElement.style.fontSize = "14px";
                        return;
                    }
                    var w =
                        (window.screen && window.screen.width) ||
                        window.innerWidth;
                    // 12px at <=1280 logical, ramping to 16px at >=2000.
                    var px = 4.8889 + 0.005556 * w;
                    document.documentElement.style.fontSize =
                        Math.max(12, Math.min(px, 16)) + "px";
                }
                applyRootScale();
                // Catches a resolution change or a drag to a second monitor.
                // Registered on window, so it outlives ClientRouter navigations
                // and only needs binding once.
                addEventListener("resize", applyRootScale);
                // The inline style, however, does NOT survive a navigation.
                // ClientRouter's swapRootAttributes strips every attribute off
                // <html> and re-applies only those the incoming document
                // carries — and that document has no style attribute, since
                // the size is set here at runtime. This script isn't re-run
                // either: it's byte-identical across pages, so the swap keeps
                // it as a persisted head element rather than executing it
                // again. Left alone, the first navigation drops the root to
                // the vw-based clamp() fallback in global.css, visibly
                // shrinking the navbar on any display where the two ramps
                // disagree — i.e. whenever the window is narrower than the
                // screen. Re-apply on each swap, which lands before paint.
                document.addEventListener("astro:after-swap", applyRootScale);
            })();

            document.documentElement.classList.add("nav-boot");
            // Homepage intro: on the first hard load of "/", start with the
            // navbar tucked off-screen behind a click-to-enter overlay. Set
            // before first paint so neither flashes.
            if (location.pathname === "/") {
                document.documentElement.classList.add("home-intro");
            }
        </script>
        <style>
            html.nav-boot [data-nav-flicker] {
                opacity: 0;
            }
        </style>
        {/* Content flickers in via the shared flicker language; keep flicker
           elements visible when JS is unavailable. */}
        <noscript>
            <style>
                [data-flicker],
                [data-fade-in],
                [data-text-reveal],
                html.nav-boot [data-nav-flicker] {
                    opacity: 1 !important;
                }
            </style>
        </noscript>
        <script>
            import "@mux/mux-player";
            import "../scripts/flicker";
            // The navbar sits where the browser draws its link URL bubble;
            // this parks each link's href while the mouse is over it.
            import "../scripts/linkPreview";

            // Homepage intro: while `home-intro` is set (hard load of "/"), the
            // navbar is hidden behind the click-to-enter overlay. Reveal it on
            // the first click anywhere; clear the state when navigating away
            // (the class lives on <html>, which survives client-side nav).
            document.addEventListener("astro:page-load", () => {
                const html = document.documentElement;
                if (
                    location.pathname === "/" &&
                    html.classList.contains("home-intro")
                ) {
                    window.addEventListener(
                        "click",
                        () => html.classList.remove("home-intro"),
                        { once: true },
                    );
                } else {
                    html.classList.remove("home-intro");
                }
            });
        </script>
    </head>
    <body data-page={isHome ? "home" : "inner"}>
        <Navbar />
        <slot />
    </body>
</html>
